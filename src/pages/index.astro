---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import HomeRoute from '../components/HomeRoute.astro';
import FeaturedStrip from '../components/FeaturedStrip.astro';

const proof = [
  { name: 'D. E. Shaw', tags: 'financial research · automation · structured data', metric: '~5 hrs → ~2 mins', href: '/work/#de-shaw' },
  { name: 'Groww', tags: 'customer friction · onboarding · support', metric: '5,000+ queries', href: '/work/#groww' },
  { name: 'Mensa Brands', tags: 'e-commerce · consumer behaviour · growth', metric: '300+ competitor products', href: '/work/#mensa' },
];

const truths = [
  '16 years of dancing and still counting',
  'wants the backstory',
  'ETA: early',
  'will happily explain it 10 different ways',
  'pasta opinions: firm',
];
---
<BaseLayout description="Hi, I’m Moksha. I like making complicated things simpler: data, research, systems, and the occasional better question.">
  <!-- HOME 1 · HERO + ROUTE -->
  <section class="home-hero container" aria-labelledby="hi">
    <div class="hh-text">
      <svg class="hh-sparks" viewBox="0 0 40 40" aria-hidden="true"><path d="M8 30L16 22M6 16l10 2M18 6l2 11" /></svg>
      <h1 class="hh-title" id="hi">
        <span class="hh-line">Hi, I’m</span>
        <span class="hh-line hh-name"><span class="hh-brush">Moksha</span><span class="hh-dot" aria-hidden="true"></span><span class="visually-hidden">.</span></span>
      </h1>
      <p class="hh-copy">
        I like making complicated <strong>things simpler.</strong><br />
        Data, research, <span class="hh-squig">systems</span>, and the occasional better question.
      </p>
    </div>

    <div class="hh-photo">
      <span class="hh-swatch" aria-hidden="true"></span>
      <svg class="hh-photo-sparks" viewBox="0 0 40 40" aria-hidden="true"><path d="M30 34L22 26M34 20l-10 1M20 8l1 11" /></svg>
      <figure class="hh-frame">
        <img src="/images/home-portrait.jpg" alt="Moksha Agrawal smiling, chin resting on her hand, at a café table" width="900" height="832" fetchpriority="high" decoding="async" />
      </figure>
      <p class="hh-note hand">
        curious about people, systems and what connects them.
        <svg viewBox="0 0 50 40" aria-hidden="true"><path d="M44 4C40 22 28 32 8 34M15 27l-8 7 9 4" /></svg>
      </p>
    </div>

    <div class="hh-route">
      <HomeRoute />
    </div>
  </section>

  <!-- HOME 2 · FEATURED PROJECT -->
  <FeaturedStrip />

  <a href="#experience" class="scroll-cue" aria-label="Scroll to the next section">
    <svg viewBox="0 0 20 70" aria-hidden="true"><path class="sc-line" d="M10 2v52" /><path d="M4 50l6 7 6-7" /></svg>
    <span class="hand">scroll to explore</span>
  </a>

  <!-- HOME 3 · EXPERIENCE -->
  <section class="section container" id="experience" aria-labelledby="proof-title">
    <div class="proof-head">
      <h2 class="t-h3" id="proof-title">A few things I’ve worked on</h2>
      <ArrowLink href="/work/" class="hide-sm">see the work</ArrowLink>
    </div>
    <ul class="proof" role="list">
      {proof.map((p, i) => (
        <li class="proof-item reveal" style={`--delay:${i * 90}ms`}>
          <a href={p.href} class="proof-link">
            <span class="proof-name head">{p.name}</span>
            <span class="proof-tags">{p.tags}</span>
            <span class="proof-metric num">{p.metric}</span>
          </a>
        </li>
      ))}
    </ul>
    <ArrowLink href="/work/" class="proof-cta-sm">see the work</ArrowLink>
  </section>

  <!-- HOME 4 · PERSONAL STRIP -->
  <section class="section container" aria-labelledby="also-title">
    <div class="also-head">
      <h2 class="t-h3" id="also-title">Also true about me</h2>
      <ArrowLink href="/about/">the slightly more personal version</ArrowLink>
    </div>
    <ul class="also-strip reveal" role="list">
      {truths.map((t) => (
        <li>{t === 'pasta opinions: firm' ? <span class="hl">{t}</span> : t}</li>
      ))}
    </ul>
  </section>

  <!-- HOME 5 · CLOSE -->
  <section class="section container close" aria-labelledby="close-title">
    <h2 class="t-section" id="close-title">Still curious?</h2>
    <ul class="close-links" role="list">
      <li><ArrowLink href="/about/" variant="ink">About</ArrowLink></li>
      <li><ArrowLink href="/work/" variant="ink">Work</ArrowLink></li>
      <li><ArrowLink href="/projects/" variant="ink">Projects</ArrowLink></li>
      <li><ArrowLink href="/notes/" variant="ink">Notes</ArrowLink></li>
    </ul>
    <p class="hand close-note">thanks for looking a little closer.</p>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    column-gap: 40px;
    padding-top: clamp(28px, 4vw, 56px);
  }
  .hh-text { position: relative; padding-top: 28px; align-self: start; }
  .hh-sparks { position: absolute; left: -30px; top: 0; width: 36px; height: 36px; }
  .hh-sparks path, .hh-photo-sparks path { fill: none; stroke: var(--cobalt); stroke-width: 2.2; stroke-linecap: round; }
  .hh-title { font-size: clamp(3.4rem, 1.6rem + 5.4vw, 6.6rem); font-weight: 700; line-height: 0.98; letter-spacing: -0.04em; }
  .hh-line { display: block; }
  .hh-name { margin-top: 0.04em; }
  .hh-brush { position: relative; z-index: 0; }
  .hh-brush::before {
    content: ''; position: absolute; z-index: -1;
    left: -0.12em; right: -0.08em; bottom: 0.04em; height: 0.42em;
    background: var(--yellow);
    border-radius: 40% 12% 46% 10% / 60% 30% 50% 40%;
    transform: rotate(-1.2deg);
    opacity: 0.9;
  }
  .hh-dot { display: inline-block; width: 0.17em; height: 0.17em; margin-left: 0.05em; border-radius: 50%; background: var(--cobalt); }
  .hh-copy { margin-top: 28px; font-size: 1.15rem; line-height: 1.6; max-width: 46ch; }
  .hh-copy strong { font-weight: 600; }
  .hh-squig { position: relative; white-space: nowrap; }
  .hh-squig::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 6px;
    background: radial-gradient(circle at 3px -1px, transparent 3px, var(--yellow) 3.2px, var(--yellow) 4.6px, transparent 4.8px) 0 0 / 7px 6px repeat-x;
  }

  .hh-photo { position: relative; align-self: start; justify-self: center; width: min(100%, 440px); margin-top: 6px; }
  .hh-frame {
    position: relative; z-index: 1;
    margin: 0;
    padding: 12px;
    background: #fff;
    transform: rotate(2.2deg);
    box-shadow: 0 18px 36px -24px rgba(60, 45, 20, 0.55);
    clip-path: polygon(0 1.5%, 6% 0, 14% 1.2%, 23% 0.2%, 31% 1.4%, 42% 0.3%, 53% 1.2%, 62% 0, 71% 1.3%, 80% 0.4%, 90% 1.4%, 100% 0.2%, 99.2% 12%, 100% 26%, 99.3% 40%, 100% 55%, 99.1% 70%, 100% 85%, 99.4% 100%, 88% 98.8%, 76% 100%, 64% 98.9%, 52% 100%, 40% 99%, 28% 100%, 16% 98.8%, 5% 100%, 0 98.5%, 0.8% 86%, 0 72%, 0.9% 58%, 0 44%, 0.7% 30%, 0 16%);
  }
  .hh-frame img { width: 100%; height: auto; display: block; }
  .hh-swatch {
    position: absolute; z-index: 0;
    left: -9%; bottom: -6%; width: 52%; height: 62%;
    background: var(--yellow); opacity: 0.85;
    border-radius: 46% 54% 38% 62% / 52% 40% 60% 48%;
    transform: rotate(-8deg);
  }
  .hh-photo-sparks { position: absolute; z-index: 2; left: -34px; top: -18px; width: 40px; height: 40px; transform: scaleX(-1); }
  .hh-note {
    position: absolute; z-index: 2;
    left: calc(100% + 18px); top: 4%;
    width: 128px;
    font-size: 1.2rem; line-height: 1.05; color: var(--cobalt);
    transform: rotate(-4deg);
  }
  .hh-note svg { display: block; width: 46px; height: 36px; margin-top: 6px; overflow: visible; }
  .hh-note path { fill: none; stroke: var(--cobalt); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

  .hh-route { grid-column: 1 / -1; margin-top: -64px; position: relative; z-index: 3; pointer-events: none; }
  .hh-route :global(a) { pointer-events: auto; }

  /* ---------- scroll cue: the route keeps going ---------- */
  .scroll-cue { display: flex; flex-direction: column; align-items: center; gap: 2px; width: fit-content; margin: 28px auto 0; color: var(--cobalt); min-height: 44px; }
  .scroll-cue svg { width: 20px; height: 70px; overflow: visible; }
  .scroll-cue path { fill: none; stroke: var(--cobalt); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .scroll-cue .sc-line { stroke-dasharray: 4 6; }
  .scroll-cue .hand { font-size: 1.1rem; color: var(--grey); transition: color var(--t-micro); }
  .scroll-cue:hover .hand { color: var(--cobalt); }
  .scroll-cue:hover svg { transform: translateY(3px); transition: transform var(--t-micro) var(--ease); }

  /* ---------- experience ---------- */
  .proof-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 24px; }
  .proof { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line-strong); }
  .proof-item + .proof-item { border-left: 1px solid var(--line); }
  .proof-link { display: grid; gap: 6px; padding: 22px 24px 24px; height: 100%; transition: background-color var(--t-micro) var(--ease); }
  .proof-item:first-child .proof-link { padding-left: 0; }
  .proof-link:hover { background: rgba(252, 249, 242, 0.7); }
  .proof-link:hover .proof-name { color: var(--cobalt); }
  .proof-name { font-size: 1.5rem; font-weight: 600; transition: color var(--t-micro) var(--ease); }
  .proof-tags { font-size: 0.9rem; color: var(--grey); }
  .proof-metric { font-size: 1.35rem; margin-top: 10px; }
  :global(.proof-cta-sm) { display: none; }

  /* ---------- personal strip ---------- */
  .also-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 22px; }
  .also-strip {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 0;
    padding: 18px 26px;
    background: var(--paper);
    box-shadow: var(--shadow-paper);
    border-radius: 3px;
    transform: rotate(-0.6deg);
    font-size: 1.05rem;
  }
  .also-strip li { display: inline-flex; align-items: center; }
  .also-strip li + li::before { content: '✦'; color: var(--cobalt); font-size: 0.7rem; margin: 0 18px; }

  /* ---------- close ---------- */
  .close-links { display: flex; flex-wrap: wrap; gap: 4px 36px; margin-top: 20px; font-size: 1.25rem; }
  .close-note { margin-top: 28px; transform: rotate(-1.5deg); transform-origin: left; display: inline-block; }

  /* ---------- responsive ---------- */
  @media (max-width: 1399px) {
    /* not enough margin on the right: the note moves into the gap left of the photo */
    .hh-note { left: auto; right: calc(100% + 28px); top: 34%; text-align: right; }
    .hh-note svg { margin-left: auto; transform: scaleX(-1); }
  }
  @media (max-width: 900px) {
    .home-hero { grid-template-columns: 1fr; row-gap: 40px; }
    .hh-photo { width: min(88%, 400px); }
    .hh-note { position: static; width: auto; margin: 22px auto 0; text-align: center; }
    .hh-note svg { display: none; }
    .hh-route { margin-top: 8px; }
  }
  @media (max-width: 760px) {
    .proof { grid-template-columns: 1fr; }
    .proof-item + .proof-item { border-left: 0; border-top: 1px solid var(--line); }
    .proof-link { padding-left: 0; }
    :global(.proof-cta-sm) { display: inline-flex; margin-top: 12px; }
    .also-strip { flex-direction: column; align-items: flex-start; gap: 8px; }
    .also-strip li + li::before { margin: 0 10px 0 0; }
    .also-strip li:first-child::before { content: '✦'; color: var(--cobalt); font-size: 0.7rem; margin: 0 10px 0 0; }
  }
  @media (max-width: 640px) {
    .hh-sparks { left: -6px; top: -8px; width: 26px; }
    .hh-text { padding-top: 22px; }
  }
</style>
