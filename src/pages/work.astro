---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Toolkit from '../components/Toolkit.astro';
import PaperFonts from '../components/PaperFonts.astro';
import DesSnapshot from '../components/work/DesSnapshot.astro';
import GrowwJourneyPanel from '../components/work/GrowwJourneyPanel.astro';
import MensaLandscape from '../components/work/MensaLandscape.astro';
import { companies } from '../data/work';

const panels: Record<string, any> = { 'de-shaw': DesSnapshot, groww: GrowwJourneyPanel, mensa: MensaLandscape };
---
<BaseLayout title="Work" description="Financial research, customer operations and e-commerce: what Moksha was actually figuring out, what she worked on, and what changed.">
  <Fragment slot="head"><PaperFonts /></Fragment>

  <div class="work theme-paper">
    <!-- HERO -->
    <section class="container w-hero" aria-labelledby="work-title">
      <div class="wh-title-wrap">
        <h1 class="wh-title" id="work-title">Work</h1>
        <svg class="wh-sparks" viewBox="0 0 30 30" aria-hidden="true"><path d="M6 3 L 3 11 M 14 5 L 9 13 M 26 10 L 15 15" /></svg>
        <svg class="wh-brush" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true">
          <path d="M2 11 C 40 6, 90 7, 140 5 S 190 6, 198 5 L 197 11 C 150 12, 100 14, 60 15 S 15 17, 3 18 Z" />
          <path d="M40 17 C 80 15, 120 15, 160 14" class="wh-brush-2" />
        </svg>
      </div>
      <p class="wh-copy">Real problems. Messy middles. Meaningful outcomes. <br />A few places where I’ve had the chance to think, build, and make an impact.</p>
      <div class="wh-doodle hide-sm" aria-hidden="true">
        <svg viewBox="0 0 180 120">
          <path d="M6 112 L 58 52 L 78 74 L 104 30 L 150 104 L 176 116" class="mt" />
          <path d="M58 52 L 66 76 M 104 30 L 98 58 L 104 82" class="mt mt-thin" />
          <path d="M104 30 V 10 M 104 10 L 118 14 L 104 19" class="mt" />
          <path d="M100 40 L 96 50 M 103 60 L 101 70 M 99 82 L 97 92" class="mt mt-dash" />
        </svg>
        <p class="hand wh-note">Different problems. <br />Same curiosity. <br />Better outcomes.</p>
      </div>
    </section>

    <!-- WHAT I WAS ACTUALLY FIGURING OUT -->
    <section class="container" aria-labelledby="figuring-title">
      <div class="figuring">
        <h2 class="figuring-title hand" id="figuring-title">What I was actually figuring out</h2>
        <ul class="sum" role="list">
          {companies.map((c) => (
            <li>
              <a href={`#${c.id}`} class="sum-card">
                <span class:list={['wordmark', `wm-${c.id}`]}>{c.name}</span>
                <span class="sum-body">
                  <span class="sum-q">{c.question}</span>
                  <span class="sum-bullets">{c.bullets.map((b) => <span>{b}</span>)}</span>
                </span>
                <span class="sum-go hand" aria-hidden="true">see how ↓</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- COMPANIES -->
    {companies.map((c) => {
      const Panel = panels[c.id];
      return (
        <section class="container co-wrap" id={c.id} aria-labelledby={`${c.id}-name`}>
          <p class="co-n hand" aria-hidden="true">{c.n}</p>
          <article class="co">
            <div class="co-left">
              <h2 class:list={['wordmark wordmark--lg', `wm-${c.id}`]} id={`${c.id}-name`}>{c.name}</h2>
              <p class="co-role">{c.role}</p>
              <p class="co-meta">{c.place} <span aria-hidden="true">·</span> {c.dates}</p>
              <p class="co-intro">{c.intro}</p>
              <p class="co-areas-label">Areas I worked on</p>
              <ul class="co-areas" role="list">{c.areas.map((a) => <li>{a}</li>)}</ul>
              <p class="hand co-note" aria-hidden="true">
                {c.note}
                <svg viewBox="0 0 50 30"><path d="M44 4 C 40 18, 26 26, 6 24 M 13 18 L 5 24 L 13 29" /></svg>
              </p>
            </div>

            <div class="co-mid">
              <h3 class="panel-title">What I worked on</h3>
              <ol class="items" role="list">
                {c.items.map((it, i) => (
                  <li class="item reveal" style={`--delay:${i * 90}ms`}>
                    <span class="item-n">{String(i + 1).padStart(2, '0')}</span>
                    <div>
                      <h4 class="item-title">{it.title}</h4>
                      <p class="item-body">{it.body}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>

            <div class="co-right">
              <Panel stats={c.outcomes} />
            </div>
          </article>
        </section>
      );
    })}

    <!-- TOOLKIT -->
    <Toolkit />

    <!-- CLOSE -->
    <section class="section container work-close" aria-labelledby="wclose-title">
      <h2 class="t-section" id="wclose-title">Different problems. Same instinct.</h2>
      <p class="body-copy wc-copy">I kept gravitating toward work that involved finding the pattern, understanding the friction, and making something clearer, faster, or easier to use.</p>
      <ArrowLink href="/projects/" variant="button">See what I’ve built</ArrowLink>
    </section>
  </div>
</BaseLayout>

<script>
  // numbers count up once, the first time they scroll into view
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('[data-count]');
  const run = (el: HTMLElement) => {
    const text = el.textContent ?? '';
    const m = text.match(/^(\D*?)(\d[\d,]*)(.*)$/);
    if (!m || reduce) return;
    const [, pre, num, post] = m;
    const target = Number(num.replace(/,/g, ''));
    const comma = num.includes(',');
    const t0 = performance.now();
    const step = (t: number) => {
      const p = Math.min(1, (t - t0) / 900);
      const v = Math.round(target * (1 - Math.pow(1 - p, 3)));
      el.textContent = pre + (comma ? v.toLocaleString('en-US') : String(v)) + post;
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); }
    }), { threshold: 0.6 });
    els.forEach((el) => io.observe(el));
  }

  // D. E. Shaw: before / after toggle
  document.querySelectorAll<HTMLElement>('[data-before-after]').forEach((root) => {
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
    btns.forEach((b) => b.addEventListener('click', () => {
      root.dataset.state = b.dataset.mode!;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }));
  });

  // Groww: tap a step to mark it
  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    const steps = root.querySelectorAll<HTMLButtonElement>('.gj-step');
    steps.forEach((s) => s.addEventListener('click', () => {
      const on = s.getAttribute('aria-pressed') !== 'true';
      steps.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      s.setAttribute('aria-pressed', String(on));
    }));
  });

  // Mensa: find the gap
  document.querySelectorAll<HTMLElement>('[data-gap-chart]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('.ml-toggle')!;
    btn.addEventListener('click', () => {
      const on = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(on));
      root.dataset.gap = on ? 'on' : 'off';
    });
  });
</script>

<style>
  /* ---------- hero ---------- */
  .w-hero { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: end; column-gap: 36px; padding-top: clamp(28px, 4vw, 56px); padding-bottom: 28px; }
  .wh-title-wrap { position: relative; }
  .wh-title { font-family: var(--font-serif-display); font-weight: 400; font-size: clamp(4.5rem, 3rem + 6vw, 8.5rem); line-height: 0.9; letter-spacing: -0.02em; color: #111; position: relative; z-index: 1; }
  .wh-sparks { position: absolute; right: -34px; top: -6px; width: 34px; height: 34px; }
  .wh-sparks path { fill: none; stroke: var(--cobalt); stroke-width: 2.4; stroke-linecap: round; }
  .wh-brush { display: block; width: 100%; height: 22px; margin-top: 4px; }
  .wh-brush path { fill: #F5CD52; opacity: 0.9; }
  .wh-brush .wh-brush-2 { fill: none; stroke: #F5CD52; stroke-width: 4; stroke-linecap: round; }
  .wh-copy { font-family: var(--font-serif-text); font-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.35rem); line-height: 1.5; color: #2c2a27; padding-bottom: 26px; }
  .wh-doodle { position: relative; width: 230px; align-self: stretch; }
  .wh-doodle svg { position: absolute; left: 0; bottom: 0; width: 190px; }
  .mt { fill: none; stroke: #2D45A8; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .mt-thin { stroke-width: 0.8; opacity: 0.6; }
  .mt-dash { stroke-dasharray: 2 4; }
  .wh-note { position: absolute; right: -24px; top: -48px; font-size: 1.05rem; line-height: 1.25; color: #2D45A8; transform: rotate(-14deg); }

  /* ---------- summary ---------- */
  .figuring { position: relative; margin-top: 18px; padding: 54px 18px 18px; border: 1px solid var(--line); border-radius: 8px; background: rgba(252, 249, 242, 0.6); }
  .figuring-title { position: absolute; top: -20px; left: 22px; margin: 0; padding: 4px 18px 6px; font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.8rem); font-weight: 400; color: var(--ink); background: #F8E3A0; border-radius: 8px 14px 10px 12px; transform: rotate(-1deg); }
  .sum { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .sum-card { position: relative; display: flex; flex-direction: column; gap: 18px; height: 100%; padding: 22px 22px 20px; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; transition: transform var(--t-micro) var(--ease), box-shadow var(--t-micro) var(--ease), border-color var(--t-micro); }
  .sum-card:hover, .sum-card:focus-visible { transform: translateY(-4px); box-shadow: var(--shadow-lift); border-color: var(--cobalt-line); }
  .sum-body { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 16px; }
  .sum-q { font-family: var(--font-serif-text); font-size: 1rem; line-height: 1.45; color: #2c2a27; padding-right: 14px; border-right: 1px solid var(--line-strong); }
  .sum-bullets { display: grid; gap: 4px; align-content: start; font-family: var(--font-serif-text); font-size: 0.9rem; color: #3b3833; }
  .sum-bullets span::before { content: '•'; color: var(--cobalt); margin-right: 8px; }
  .sum-go { position: absolute; right: 18px; top: 20px; font-size: 0.95rem; color: var(--cobalt); opacity: 0; transform: translateY(-3px); transition: opacity var(--t-micro), transform var(--t-micro) var(--ease); }
  .sum-card:hover .sum-go, .sum-card:focus-visible .sum-go { opacity: 1; transform: none; }

  /* company names, set as type (no logos redrawn) */
  .wordmark { display: block; width: fit-content; font-size: 1.9rem; line-height: 1.05; letter-spacing: -0.02em; }
  .wordmark--lg { font-size: clamp(2.1rem, 1.6rem + 1.4vw, 2.8rem); }
  .wm-de-shaw { font-family: var(--font-serif-display); color: #1F2F6B; font-weight: 400; }
  .wm-groww { font-family: var(--font-body); font-weight: 600; color: #111; letter-spacing: -0.035em; }
  .wm-mensa { font-family: var(--font-body); font-weight: 600; text-transform: uppercase; color: #111; letter-spacing: 0.02em; font-size: 1.6rem; max-width: 7ch; line-height: 1.02; }
  .wordmark--lg.wm-mensa { font-size: clamp(1.8rem, 1.4rem + 1.2vw, 2.4rem); }

  /* ---------- company blocks ---------- */
  .co-wrap { position: relative; margin-top: 34px; }
  .co-n { position: absolute; left: calc(var(--gutter) - 34px); top: -14px; margin: 0; font-size: 1.4rem; color: var(--cobalt); }
  .co {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 0.85fr) minmax(0, 1.35fr);
    border: 1px solid var(--line); border-radius: 8px;
    background: rgba(252, 249, 242, 0.55);
  }
  .co > div { padding: 30px 28px; min-width: 0; }
  .co-mid { border-left: 1px solid var(--line); }
  .co-right { padding: 14px !important; }
  .co-right > :global(*) { height: 100%; padding: 22px 24px; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; }

  .co-role { display: inline-block; margin-top: 14px; padding: 4px 14px; font-family: var(--font-serif-text); font-size: 1rem; background: #F8E9BC; border-radius: 999px; }
  .co-meta { margin-top: 10px; font-family: var(--font-serif-text); font-size: 0.95rem; color: var(--grey); }
  .co-intro { margin-top: 22px; font-family: var(--font-serif-text); font-size: 1.05rem; line-height: 1.6; color: #2c2a27; }
  .co-areas-label { margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--grey); }
  .co-areas { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; max-width: 64%; }
  .co-areas li { padding: 6px 14px; font-size: 0.85rem; background: rgba(23, 23, 23, 0.05); border-radius: 999px; }
  .co-left { position: relative; }
  .co-note { position: absolute; right: 16px; bottom: 34px; width: 112px; margin: 0; font-size: 1rem; line-height: 1.25; color: var(--cobalt); transform: rotate(-14deg); }
  .co-note svg { display: block; width: 40px; margin: 4px 0 0 -16px; overflow: visible; }
  .co-note path { fill: none; stroke: var(--cobalt); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }

  .work :global(.panel-title) { font-family: var(--font-serif-text); font-weight: 600; font-size: 1.2rem; letter-spacing: -0.005em; color: var(--ink); }
  .work :global(.panel-sub) { font-weight: 400; color: #3b3833; }
  .work :global(.ko-label) { display: inline-block; margin: 16px 0 8px; padding: 2px 12px; font-family: var(--font-hand-print); font-size: 1rem; background: #F8E3A0; border-radius: 5px; transform: rotate(-1deg); }

  .items { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 30px; }
  .item { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 16px; align-items: start; }
  .item-n { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #E3EAFB; color: var(--cobalt); font-family: var(--font-serif-text); font-size: 0.8rem; font-weight: 600; transition: background-color var(--t-micro), color var(--t-micro); }
  .item:hover .item-n { background: var(--cobalt); color: #fff; }
  .item-title { font-family: var(--font-serif-text); font-weight: 600; font-size: 1.02rem; color: var(--ink); }
  .item-body { margin-top: 6px; font-family: var(--font-serif-text); font-size: 0.92rem; line-height: 1.5; color: var(--grey); }

  /* toolkit + close keep the site's base type, spaced from the blocks above */
  .work :global(.toolkit) { margin-top: 24px; }
  .work-close { max-width: 820px; }
  .wc-copy { margin: 20px 0 32px; }

  @media (max-width: 1180px) {
    .co { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .co-right { grid-column: 1 / -1; border-top: 1px solid var(--line); }
    .w-hero { grid-template-columns: auto minmax(0, 1fr); }
    .wh-doodle { display: none; }
  }
  @media (max-width: 900px) {
    .sum { grid-template-columns: 1fr; }
    .w-hero { grid-template-columns: 1fr; row-gap: 12px; }
    .wh-title-wrap { width: fit-content; }
    .wh-copy { padding-bottom: 0; }
  }
  @media (max-width: 760px) {
    .co { grid-template-columns: 1fr; }
    .co-mid { border-left: 0; border-top: 1px solid var(--line); }
    .co > div { padding: 24px 20px; }
    .co-note { position: static; width: auto; margin-top: 18px; transform: rotate(-3deg); }
    .co-note svg { display: none; }
    .co-areas { max-width: none; }
    .co-n { position: static; margin-bottom: 4px; }
    .co-right > :global(*) { padding: 18px 16px; }
  }
</style>
