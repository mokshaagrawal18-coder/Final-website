---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Toolkit from '../components/Toolkit.astro';
import DesLoop from '../components/work/DesLoop.astro';
import GrowwJourneyPanel from '../components/work/GrowwJourneyPanel.astro';
import MensaLandscape from '../components/work/MensaLandscape.astro';
import CompanyMark from '../components/work/CompanyMark.astro';
import { companies } from '../data/work';

const visuals: Record<string, any> = { 'de-shaw': DesLoop, groww: GrowwJourneyPanel, mensa: MensaLandscape };
---
<BaseLayout title="Work" description="Financial research, customer operations and e-commerce: what Moksha was figuring out, what she worked on, and what changed.">
  <div class="work theme-paper">
    <!-- HERO -->
    <section class="container w-hero" aria-labelledby="work-title">
      <div class="wh-title-wrap">
        <h1 class="wh-title" id="work-title">Work</h1>
        <svg class="wh-sparks" viewBox="0 0 30 30" aria-hidden="true"><path d="M6 3 L 3 11 M 14 5 L 9 13 M 26 10 L 15 15" /></svg>
        <svg class="wh-brush" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true">
          <path d="M2 11 C 40 6, 90 7, 140 5 S 190 6, 198 5 L 197 11 C 150 12, 100 14, 60 15 S 15 17, 3 18 Z" />
        </svg>
      </div>
      <p class="wh-copy">Different problems, same instinct: understand what’s happening, find what matters, and make the next step easier.</p>
      <div class="wh-doodle hide-sm" aria-hidden="true">
        <svg viewBox="0 0 180 120">
          <path d="M6 112 L 58 52 L 78 74 L 104 30 L 150 104 L 176 116" class="mt" />
          <path d="M104 30 V 10 M 104 10 L 118 14 L 104 19" class="mt" />
          <path d="M100 40 L 96 50 M 103 60 L 101 70 M 99 82 L 97 92" class="mt mt-dash" />
        </svg>
        <p class="hand wh-note">different problems. <br />same curiosity.</p>
      </div>
    </section>

    <!-- WHAT I WAS ACTUALLY FIGURING OUT -->
    <section class="container figuring" aria-labelledby="figuring-title">
      <h2 class="figuring-title hand" id="figuring-title">What I was actually figuring out</h2>
      <ul class="sum" role="list">
        {companies.map((c) => (
          <li>
            <a href={`#${c.id}`} class="sum-card">
              <CompanyMark id={c.id} name={c.name} />
              <span class="sum-q">{c.question}</span>
              <span class="sum-foot">
                <span class="sum-key hand">{c.keyword}</span>
                <span class="sum-ev">{c.bullets.map((b) => <span>{b}</span>)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- COMPANIES -->
    {companies.map((c) => {
      const Visual = visuals[c.id];
      return (
        <section class="container co-wrap" id={c.id} aria-labelledby={`${c.id}-name`}>
          <p class="co-n hand" aria-hidden="true">{c.n}</p>
          <article class="co">
            <div class="co-left">
              <CompanyMark id={c.id} name={c.company ?? c.name} size="lg" as="h2" titleId={`${c.id}-name`} />
              {c.company && <p class="co-now">{c.company}</p>}
              <p class="co-role">{c.role}</p>
              <p class="co-meta">{c.place} <span aria-hidden="true">·</span> {c.dates}</p>
              <p class="co-intro">{c.intro}</p>
            </div>

            <ol class="items" role="list" aria-label={`What I worked on at ${c.name}`}>
              {c.items.map((it, i) => (
                <li class="item reveal" style={`--delay:${i * 80}ms`}>
                  <span class="item-n">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3 class="item-title">{it.title}</h3>
                    <p class="item-body">{it.body}</p>
                    {it.evidence && (
                      <ul class="item-ev" role="list" aria-label="Evidence">
                        {it.evidence.map((e) => <li>{e}</li>)}
                      </ul>
                    )}
                    {it.hand && <p class="hand item-hand">{it.hand}</p>}
                    {it.quote && <blockquote class="item-quote">{it.quote}</blockquote>}
                  </div>
                </li>
              ))}
            </ol>

            <div class="co-visual">
              <Visual />
            </div>
          </article>
        </section>
      );
    })}

    <!-- TOOLKIT -->
    <Toolkit />

    <!-- NEXT -->
    <section class="container work-next">
      <ArrowLink href="/projects/" variant="button">See what I’ve built</ArrowLink>
    </section>
  </div>
</BaseLayout>

<script>
  // 01 / 02 / 03 marker highlights for the company in view
  const markers = document.querySelectorAll<HTMLElement>('.co-n');
  if (markers.length && 'IntersectionObserver' in window) {
    const so = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      markers.forEach((m) => m.classList.toggle('is-current', m.parentElement === e.target));
    }), { rootMargin: '-45% 0px -50% 0px' });
    document.querySelectorAll('.co-wrap').forEach((sec) => so.observe(sec));
  }
</script>

<style>
  /* ---------- hero ---------- */
  .w-hero { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: end; column-gap: 40px; padding-top: clamp(28px, 4vw, 56px); padding-bottom: 12px; }
  .wh-title-wrap { position: relative; }
  .wh-title { font-family: var(--font-serif-display); font-weight: 400; font-size: clamp(4.5rem, 3rem + 6vw, 8.5rem); line-height: 0.9; letter-spacing: -0.02em; color: #111; position: relative; z-index: 1; }
  .wh-sparks { position: absolute; right: -34px; top: -6px; width: 34px; height: 34px; }
  .wh-sparks path { fill: none; stroke: var(--cobalt); stroke-width: 2.4; stroke-linecap: round; }
  .wh-brush { display: block; width: 100%; height: 18px; margin-top: 4px; }
  .wh-brush path { fill: #F5CD52; opacity: 0.9; }
  .wh-copy { max-width: 34ch; font-family: var(--font-serif-text); font-size: clamp(1.1rem, 0.95rem + 0.5vw, 1.4rem); line-height: 1.5; color: #2c2a27; padding-bottom: 24px; }
  .wh-doodle { position: relative; width: 210px; height: 150px; margin-top: 40px; }
  .wh-doodle svg { position: absolute; left: 0; bottom: 0; width: 170px; }
  .mt { fill: none; stroke: #2D45A8; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .mt-dash { stroke-dasharray: 2 4; }
  .wh-note { position: absolute; right: -6px; top: -14px; font-size: 1.05rem; line-height: 1.25; color: var(--cobalt); transform: rotate(-12deg); }

  /* ---------- summary: compact, glanceable ---------- */
  .figuring { margin-top: clamp(40px, 5vw, 64px); }
  .figuring-title { display: inline-block; margin: 0 0 18px; padding: 4px 16px 6px; font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.7rem); font-weight: 400; color: var(--ink); background: #F8E3A0; border-radius: 8px 14px 10px 12px; transform: rotate(-1deg); }
  .sum { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .sum-card { display: flex; flex-direction: column; gap: 14px; height: 100%; padding: 22px 22px 18px; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; transition: transform var(--t-micro) var(--ease), border-color var(--t-micro); }
  .sum-card:hover, .sum-card:focus-visible { transform: translateY(-3px); border-color: var(--cobalt-line); }
  .sum-card :global(.cm--sm) { font-size: 1.55rem; }
  .sum-q { font-family: var(--font-serif-text); font-size: 1rem; line-height: 1.45; color: #2c2a27; }
  .sum-foot { margin-top: auto; display: flex; align-items: baseline; gap: 14px; padding-top: 12px; border-top: 1px solid var(--line); }
  .sum-key { font-size: 1.1rem; color: var(--cobalt); line-height: 1; }
  .sum-ev { display: flex; flex-wrap: wrap; gap: 2px 12px; font-size: 0.85rem; font-weight: 500; color: var(--ink); }

  /* ---------- company sections: open layout, no boxes ---------- */
  .co-wrap { position: relative; margin-top: clamp(96px, 9vw, 140px); }
  .co-n { margin: 0 0 18px; font-size: 1.4rem; color: var(--cobalt); opacity: 0.5; transform-origin: left center; width: fit-content; transition: opacity var(--t-micro), transform var(--t-micro) var(--ease); }
  .co-n.is-current { opacity: 1; transform: scale(1.12); }
  .co {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr) minmax(0, 1fr);
    column-gap: clamp(36px, 4vw, 64px);
    align-items: start;
    padding-top: 30px;
    border-top: 1px solid var(--line);
  }
  .co-now { margin-top: 6px; font-size: 0.82rem; color: var(--grey); }
  .co-role { display: inline-block; margin-top: 14px; padding: 4px 14px; font-family: var(--font-serif-text); font-size: 0.98rem; background: #F8E9BC; border-radius: 999px; }
  .co-meta { margin-top: 8px; font-family: var(--font-serif-text); font-size: 0.92rem; color: var(--grey); }
  .co-intro { margin-top: 20px; max-width: 38ch; font-family: var(--font-serif-text); font-size: 1.03rem; line-height: 1.6; color: #2c2a27; }

  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 34px; }
  .item { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 14px; align-items: start; transition: transform var(--t-micro) var(--ease); }
  .item:hover { transform: translateY(-2px); }
  .item-n { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #E3EAFB; color: var(--cobalt); font-family: var(--font-serif-text); font-size: 0.72rem; font-weight: 600; }
  .item-n { transition: background-color 300ms, color 300ms; }
  .item.is-active .item-n { background: var(--cobalt); color: #fff; }
  .item-title { font-family: var(--font-serif-text); font-weight: 600; font-size: 1.08rem; color: var(--ink); }
  .item-body { margin-top: 6px; max-width: 46ch; font-family: var(--font-serif-text); font-size: 0.95rem; line-height: 1.55; color: #4a4741; }
  .item-ev { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .item-ev li { font-size: 0.82rem; font-weight: 600; color: var(--cobalt); }
  .item-ev li + li::before { content: '·'; color: var(--grey); margin-right: 14px; font-weight: 400; }
  .item-hand { margin-top: 8px; font-size: 0.95rem; line-height: 1.25; color: var(--cobalt); opacity: 0.75; transform: rotate(-1deg); transform-origin: left; max-width: 40ch; }
  .item-quote { margin: 12px 0 0; padding-left: 12px; border-left: 2px solid var(--yellow); max-width: 42ch; font-family: var(--font-serif-text); font-style: italic; font-size: 0.95rem; line-height: 1.45; color: #3b3833; }

  .co-visual { position: sticky; top: 110px; padding: 22px 22px 20px; background: rgba(252, 249, 242, 0.7); border-radius: 8px; }
  .work :global(.panel-title) { font-family: var(--font-serif-text); font-weight: 600; font-size: 1rem; color: var(--ink); }
  .work :global(.panel-sub) { font-weight: 400; color: var(--grey); }

  .work :global(.toolkit) { padding-top: clamp(110px, 10vw, 160px); }
  .work-next { padding-top: 64px; }

  @media (max-width: 1100px) {
    .co { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr); row-gap: 36px; }
    .co-visual { grid-column: 1 / -1; position: static; max-width: 560px; }
    .w-hero { grid-template-columns: auto minmax(0, 1fr); }
    .wh-doodle { display: none; }
  }
  @media (max-width: 860px) {
    .sum { grid-template-columns: 1fr; }
    .co { grid-template-columns: 1fr; }
    .w-hero { grid-template-columns: 1fr; row-gap: 12px; }
    .wh-title-wrap { width: fit-content; }
    .wh-copy { padding-bottom: 0; }
  }
</style>
