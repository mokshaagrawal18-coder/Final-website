---
import BaseLayout from './BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ExpandableDetails from '../components/ExpandableDetails.astro';

interface Props {
  title: string;
  titleLines?: string[];
  description: string;
  question: string;
  intro: string;
  did: { title: string; body: string }[];
  stoodOut: string;
  keyLine: string;
  proof: string[];
  reflection: string;
  reflectionHand?: boolean;
  detailsLabel: string;
  next: { href: string; label: string };
  report?: string;
}
const p = Astro.props;
---
<BaseLayout title={p.title} description={p.description}>
  <article>
    <header class="container grid pd-hero">
      <div class="pd-hero-main">
        <ArrowLink href="/projects/" dir="left" variant="ink" class="pd-back">Projects</ArrowLink>
        <h1 class="t-page pd-title">{p.titleLines ? p.titleLines.map((l, i) => <>{l}{i < p.titleLines!.length - 1 && <br />}</>) : p.title}</h1>
        <p class="pd-q">{p.question}</p>
        <p class="lede pd-intro">{p.intro}</p>
        {p.report && <ArrowLink href={p.report} variant="button" external class="pd-report">View research report</ArrowLink>}
      </div>
    </header>

    <div class="container pd-visual">
      <slot name="visual" />
    </div>

    <section class="section container" aria-labelledby="did-title">
      <h2 class="label pd-label" id="did-title">What I did</h2>
      <ol class="did" role="list">
        {p.did.map((d, i) => (
          <li class="did-item reveal" style={`--delay:${i * 90}ms`}>
            <span class="num did-n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="did-title">{d.title}</h3>
            <p class="did-body">{d.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section container grid" aria-labelledby="stood-title">
      <div class="stood">
        <h2 class="label pd-label" id="stood-title">What stood out</h2>
        <p class="stood-copy">{p.stoodOut}</p>
        <p class="key-line head"><span class="hl">{p.keyLine}</span></p>
      </div>
      <div class="proof-col">
        <h2 class="label pd-label">Proof</h2>
        <ul class="proof-list" role="list">
          {p.proof.map((x) => <li class="num">{x}</li>)}
        </ul>
      </div>
    </section>

    <section class="section container">
      <p class:list={['reflection', { hand: p.reflectionHand }]}>{p.reflection}</p>
    </section>

    <section class="section container">
      <ExpandableDetails label={p.detailsLabel} id="how">
        <slot name="details" />
      </ExpandableDetails>
    </section>

    <nav class="section container pd-next" aria-label="More projects">
      <ArrowLink href="/projects/" dir="left" variant="ink">All projects</ArrowLink>
      <ArrowLink href={p.next.href}>{p.next.label}</ArrowLink>
    </nav>
  </article>
</BaseLayout>

<style>
  .pd-hero { padding-top: clamp(24px, 4vw, 64px); }
  .pd-hero-main { grid-column: 1 / span 9; }
  :global(.pd-back) { font-size: 0.95rem; margin-bottom: 20px; }
  .pd-q { margin-top: 26px; font-size: clamp(1.2rem, 1rem + 0.7vw, 1.6rem); font-weight: 500; color: var(--cobalt); line-height: 1.35; max-width: 34ch; }
  .pd-intro { margin-top: 20px; max-width: 46ch; }
  :global(.pd-report) { margin-top: 26px; }
  .pd-visual { margin-top: clamp(48px, 5vw, 72px); }
  .pd-visual > :global(*) { max-width: 760px; }

  .pd-label { margin-bottom: 20px; font-family: var(--font-body); }
  .did { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1.5px solid var(--ink); }
  .did-item { padding: 24px 28px 8px 0; }
  .did-item + .did-item { padding-left: 28px; border-left: 1px solid var(--line); }
  .did-n { font-size: 0.95rem; }
  .did-title { margin-top: 14px; font-size: 1.35rem; font-weight: 600; letter-spacing: -0.015em; }
  .did-body { margin-top: 10px; color: var(--grey); }

  .stood { grid-column: 1 / span 7; }
  .stood-copy { max-width: 52ch; font-size: 1.1rem; }
  .key-line { margin-top: 28px; font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.5rem); font-weight: 650; line-height: 1.2; max-width: 22ch; }
  .proof-col { grid-column: 9 / span 4; }
  .proof-list { border-top: 1px solid var(--line-strong); }
  .proof-list li { padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 1.15rem; }

  .reflection { max-width: 36ch; font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.8rem); line-height: 1.35; font-family: var(--font-head); font-weight: 500; letter-spacing: -0.015em; }
  .reflection.hand { font-family: var(--font-hand); font-size: clamp(1.7rem, 1.4rem + 1vw, 2.2rem); transform: rotate(-1deg); transform-origin: left; }
  .reflection::before { content: ''; display: block; width: 40px; height: 2px; background: var(--red); margin-bottom: 20px; }
  .reflection.hand::before { display: none; }

  .pd-next { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; padding-top: 64px !important; }

  @media (max-width: 1024px) {
    .pd-hero-main, .stood, .proof-col { grid-column: 1 / -1; }
    .proof-col { margin-top: 48px; }
    .did { grid-template-columns: 1fr; }
    .did-item, .did-item + .did-item { padding: 22px 0; border-left: 0; border-top: 1px solid var(--line); }
    .did-item:first-child { border-top: 0; }
  }
</style>
