---
/** Home: "Also true about me" — five small truths as an icon row (line drawings, not stock icons). */
const items = [
  {
    label: ['16+ years', 'of dancing'], note: 'and still counting',
    // dancer: head, raised arm, flowing skirt
    icon: '<circle cx="27" cy="9" r="3.2"/><path d="M26 13 C 24 18, 23 22, 22 26"/><path d="M25 15 C 29 12, 32 9, 34 4"/><path d="M24 17 C 20 18, 17 21, 15 25"/><path d="M22 26 C 18 30, 15 34, 12 36 C 17 37, 24 36, 30 33 C 27 31, 24 29, 22 26"/><path d="M20 35 L 18 44 M 25 35 L 29 43"/>',
  },
  {
    label: ['wants', 'the backstory'], note: 'ads, films, people, decisions',
    // clapperboard
    icon: '<rect x="8" y="18" width="32" height="22" rx="2"/><path d="M8 18 L 37 9 L 39 15 L 10 24"/><path d="M15 16 L 19 21 M 22 14 L 26 19 M 29 12 L 33 17"/><path d="M14 30 H 30 M 14 35 H 24"/>',
  },
  {
    label: ['ETA: early'], note: 'as a personality trait, unfortunately',
    // alarm clock with bells and feet
    icon: '<circle cx="24" cy="26" r="13"/><path d="M24 19 V 26 L 29 29"/><path d="M11 13 A 6 6 0 0 1 19 9 Z M 37 13 A 6 6 0 0 0 29 9 Z"/><path d="M15 37 L 12 42 M 33 37 L 36 42"/>',
  },
  {
    label: ['will happily', 'explain it', '10 different ways'], note: 'clarity first',
    // two speech bubbles
    icon: '<path d="M6 10 H 28 A 3 3 0 0 1 31 13 V 24 A 3 3 0 0 1 28 27 H 15 L 9 32 V 27 H 6 A 3 3 0 0 1 3 24 V 13 A 3 3 0 0 1 6 10 Z"/><path d="M33 18 H 42 A 3 3 0 0 1 45 21 V 31 A 3 3 0 0 1 42 34 H 40 V 39 L 34 34 H 25 A 3 3 0 0 1 22 31 V 30"/><path d="M11 18.5 h.01 M 17 18.5 h.01 M 23 18.5 h.01" class="dots"/>',
  },
  {
    label: ['pasta', 'opinions: firm'], note: 'very firm',
    // bowl of pasta with a fork
    icon: '<path d="M6 24 H 42 C 42 33, 34 39, 24 39 C 14 39, 6 33, 6 24 Z"/><path d="M16 39 L 15 42 H 33 L 32 39"/><path d="M10 24 C 12 18, 18 16, 22 20 C 25 15, 32 15, 34 20 C 37 18, 40 20, 39 24"/><path d="M15 22 C 17 19, 20 19, 21 22 M 26 21 C 28 18, 31 18, 32 21"/><path d="M36 4 L 30 18 M 33 3 L 28 16 M 39 5 L 33 18"/>',
    sparks: true,
  },
];
---
<section class="section container also" aria-labelledby="also-title">
  <h2 class="also-title" id="also-title">Also true about me</h2>
  <ul class="also-row" role="list">
    {items.map((it, i) => (
      <li class="also-item reveal" style={`--delay:${i * 80}ms`}>
        <span class="also-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" set:html={it.icon} />
          {it.sparks && <svg class="also-sparks" viewBox="0 0 20 20"><path d="M4 2 L 6 7 M 11 2 L 10 7 M 17 6 L 13 9" /></svg>}
        </span>
        <span class="also-label">{it.label.map((l, j) => <>{l}{j < it.label.length - 1 && <br />}</>)}</span>
        <span class="also-note">{it.note}</span>
      </li>
    ))}
  </ul>
  <a href="/about/" class="also-cta">the slightly more personal version <span aria-hidden="true">→</span></a>
</section>

<style>
  .also-title { font-family: var(--font-serif-display); font-weight: 400; font-size: clamp(2rem, 1.5rem + 1.4vw, 2.7rem); letter-spacing: -0.015em; margin-bottom: 30px; }
  .also-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .also-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 6px 18px 4px; }
  .also-item + .also-item { border-left: 1px solid var(--line); }
  .also-icon { position: relative; display: grid; place-items: center; width: 56px; height: 56px; margin-bottom: 4px; transition: transform var(--t-micro) var(--ease); }
  .also-icon svg { width: 52px; height: 52px; overflow: visible; }
  .also-icon :global(path), .also-icon :global(circle), .also-icon :global(rect) { fill: none; stroke: #2D45A8; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .also-icon :global(.dots) { stroke-width: 3; }
  .also-sparks { position: absolute; right: -16px; top: -14px; width: 20px !important; height: 20px !important; }
  .also-item:hover .also-icon { transform: translateY(-4px) rotate(-4deg); }
  .also-label { font-family: var(--font-serif-text); font-weight: 600; font-size: 1.05rem; line-height: 1.3; color: var(--ink); }
  .also-note { font-family: var(--font-hand-print); font-size: 0.95rem; line-height: 1.25; color: var(--cobalt); max-width: 16ch; }
  .also-cta {
    display: table; margin: 34px auto 0;
    padding: 6px 18px; min-height: 44px; line-height: 32px;
    font-family: var(--font-hand-print); font-size: 1.1rem; color: var(--ink);
    background: #F8E3A0; border-radius: 8px 14px 9px 12px;
    transform: rotate(-1deg);
    transition: transform var(--t-micro) var(--ease), background-color var(--t-micro);
  }
  .also-cta span { display: inline-block; color: var(--cobalt); transition: transform var(--t-micro) var(--ease); }
  .also-cta:hover { background: #F5D97E; }
  .also-cta:hover span { transform: translateX(4px); }

  @media (max-width: 900px) {
    .also-row { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 28px; }
    .also-item:nth-child(4) { border-left: 0; }
  }
  @media (max-width: 560px) {
    .also-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .also-item + .also-item { border-left: 0; }
    .also-item:nth-child(even) { border-left: 1px solid var(--line); }
    .also-item:last-child { grid-column: 1 / -1; border-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .also-item:hover .also-icon { transform: none; } }
</style>
