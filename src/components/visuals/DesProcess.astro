---
/** filings + reports + fund data → clean / compare / analyse → dashboard / insight / reusable dataset */
const inputs = ['filings', 'reports', 'fund data'];
const steps = ['clean', 'compare', 'analyse'];
const outputs = ['dashboard', 'insight', 'reusable dataset'];
---
<figure class="des-flow" data-reveal aria-label="Process: filings, reports and fund data are cleaned, compared and analysed, producing a dashboard, insight and a reusable dataset.">
  <div class="df-col df-in">
    <p class="df-label">in</p>
    {inputs.map((t, i) => <span class={`df-chip df-chip--in s${i}`}>{t}</span>)}
  </div>
  <svg class="df-link draw" viewBox="0 0 80 150" preserveAspectRatio="none" aria-hidden="true">
    <path d="M2 25 C 40 25, 40 75, 78 75" style="--len:100" />
    <path d="M2 75 L 78 75" style="--len:80;--delay:200ms" />
    <path d="M2 125 C 40 125, 40 75, 78 75" style="--len:100;--delay:300ms" />
  </svg>
  <div class="df-col df-mid">
    <p class="df-label">work</p>
    <div class="df-core">
      {steps.map((t, i) => <span class="df-step"><span class="df-dot" aria-hidden="true"></span>{t}</span>)}
    </div>
  </div>
  <svg class="df-link draw" viewBox="0 0 80 150" preserveAspectRatio="none" aria-hidden="true">
    <path d="M2 75 C 40 75, 40 25, 78 25" style="--len:100;--delay:500ms" />
    <path d="M2 75 L 78 75" style="--len:80;--delay:600ms" />
    <path d="M2 75 C 40 75, 40 125, 78 125" style="--len:100;--delay:700ms" />
  </svg>
  <div class="df-col df-out">
    <p class="df-label">out</p>
    {outputs.map((t) => <span class="df-chip df-chip--out">{t}</span>)}
  </div>
</figure>
<style>
  .des-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1.1fr) 72px minmax(0, 1fr);
    align-items: center;
    padding: 28px 0 8px;
  }
  .df-col { display: grid; gap: 12px; justify-items: stretch; position: relative; }
  .df-label { position: absolute; top: -26px; left: 0; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--grey); }
  .df-chip {
    display: flex; align-items: center; min-height: 40px;
    padding: 8px 14px; font-size: 0.95rem;
    border: 1px solid var(--line-strong); border-radius: 4px; background: var(--paper);
  }
  .df-chip--in.s0 { border-radius: 2px 10px 2px 2px; }
  .df-chip--in.s1 { border-style: dashed; }
  .df-chip--in.s2 { border-radius: 14px; }
  .df-chip--out { border-color: var(--cobalt); color: var(--cobalt); font-weight: 500; }
  .df-core {
    display: grid; gap: 4px;
    padding: 18px 20px;
    border: 1.5px solid var(--cobalt); border-radius: 6px;
    background: var(--paper);
  }
  .df-step { display: flex; align-items: center; gap: 10px; font-family: var(--font-head); font-weight: 600; font-size: 1.15rem; line-height: 1.6; }
  .df-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--yellow); box-shadow: 0 0 0 1px #d2a82f; }
  .df-link { width: 100%; height: 150px; overflow: visible; }
  .df-link path { fill: none; stroke: var(--cobalt); stroke-width: 1.4; stroke-linecap: round; vector-effect: non-scaling-stroke; }

  @media (max-width: 760px) {
    .des-flow { grid-template-columns: 1fr; row-gap: 0; }
    .df-link { height: 36px; width: 40px; justify-self: center; transform: rotate(90deg); }
    .df-col { padding-top: 26px; }
    .df-label { top: 0; }
    .df-in, .df-out { grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .df-chip { font-size: 0.85rem; padding: 6px 10px; }
  }
</style>
