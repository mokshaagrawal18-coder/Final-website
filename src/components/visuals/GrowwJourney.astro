---
/** sign up → KYC → activation → support, with where the friction sat and what changed. */
const stops = [
  { label: 'sign up', friction: false, metric: '' },
  { label: 'KYC', friction: true, metric: '5,000+ queries analysed' },
  { label: 'activation', friction: true, metric: 'activation time ↓ ~25%' },
  { label: 'support', friction: true, metric: 'escalations ↓ ~20%' },
];
---
<figure class="journey" data-reveal>
  <figcaption class="visually-hidden">Customer journey from sign up to KYC, activation and support. Friction appeared at KYC, activation and support; activation time fell about 25% and escalations about 20%.</figcaption>
  <div class="j-track" aria-hidden="true"><span class="j-fill"></span></div>
  <ol class="j-stops" role="list">
    {stops.map((s, i) => (
      <li class="j-stop" style={`--i:${i}`}>
        <span class="j-node" aria-hidden="true"></span>
        <span class="j-label head">{s.label}</span>
        {s.friction && (
          <span class="j-friction" aria-hidden="true">
            <svg viewBox="0 0 24 16"><path d="M3 12 L7 4 L11 12 L15 4 L19 12" /></svg>
          </span>
        )}
        {s.metric && <span class="j-metric">{s.metric}</span>}
      </li>
    ))}
  </ol>
  <p class="j-foot"><span class="j-foot-mark" aria-hidden="true"></span> where friction showed up · <span class="num">onboarding efficiency ↑ ~30%</span></p>
</figure>
<style>
  .journey { position: relative; padding: 16px 0 0; }
  .j-track { position: absolute; left: 12px; right: 12%; top: 25px; height: 2px; background: var(--line-strong); }
  .j-fill { position: absolute; inset: 0; background: var(--cobalt); transform-origin: left; }
  :global(.js) .j-fill { transform: scaleX(0); transition: transform 1000ms var(--ease) 150ms; }
  :global(.js) .journey.is-in .j-fill { transform: scaleX(1); }
  .j-stops { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; position: relative; }
  .j-stop { display: grid; justify-items: start; gap: 10px; }
  .j-node { width: 20px; height: 20px; border-radius: 50%; background: var(--cream); border: 2px solid var(--cobalt); }
  .j-label { font-size: 1.3rem; font-weight: 600; }
  .j-friction svg { width: 26px; height: 16px; fill: none; stroke: var(--red); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .j-metric { font-family: var(--font-head); font-weight: 600; color: var(--cobalt); font-size: 1rem; }
  :global(.js) .j-friction, :global(.js) .j-metric { opacity: 0; transform: translateY(6px); transition: opacity 400ms var(--ease), transform 400ms var(--ease); transition-delay: calc(350ms + var(--i) * 260ms); }
  :global(.js) .journey.is-in .j-friction, :global(.js) .journey.is-in .j-metric { opacity: 1; transform: none; }
  .j-foot { margin-top: 26px; font-size: 0.875rem; color: var(--grey); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .j-foot-mark { width: 16px; height: 2px; background: var(--red); display: inline-block; }
  .j-foot .num { font-size: 0.95rem; }
  @media (max-width: 640px) {
    .j-track { left: 9px; right: auto; top: 20px; bottom: 60px; width: 2px; height: auto; }
    .j-fill { transform-origin: top; }
    :global(.js) .j-fill { transform: scaleY(0); }
    :global(.js) .journey.is-in .j-fill { transform: scaleY(1); }
    .j-stops { grid-template-columns: 1fr; gap: 22px; }
    .j-stop { grid-template-columns: 20px auto auto; align-items: center; column-gap: 14px; row-gap: 2px; }
    .j-metric { grid-column: 2 / -1; }
  }
</style>
