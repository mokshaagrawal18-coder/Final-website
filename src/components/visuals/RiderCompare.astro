---
/**
 * "Same rider. Different conditions." — explanatory, not evidence.
 * Labelled as an illustration so nobody reads it as a result.
 */
interface Props { compact?: boolean; class?: string }
const { compact = false, class: cls = '' } = Astro.props;

const riders = [
  { id: 'A', conditions: ['normal traffic', 'clear weather', 'shorter route'], score: 86, adjusted: 84 },
  { id: 'B', conditions: ['heavy traffic', 'rain', 'longer route'], score: 72, adjusted: 82 },
];
const icons: Record<string, string> = {
  'normal traffic': 'M3 12h18M6 8h4M14 16h4',
  'heavy traffic': 'M3 12h18M4 8h3M9 8h3M14 8h3M5 16h3M10 16h3M15 16h3',
  'clear weather': 'M12 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10M12 2v2M12 20v2M2 12h2M20 12h2',
  rain: 'M6 13a4 4 0 0 1 1-8a5 5 0 0 1 9 1a3.5 3.5 0 0 1 1 7zM8 16l-1 3M12 16l-1 3M16 16l-1 3',
  'shorter route': 'M5 17a2 2 0 1 0 0.01 0M19 7a2 2 0 1 0 0.01 0M6.5 15.5L17.5 8.5',
  'longer route': 'M5 19a2 2 0 1 0 0.01 0M19 5a2 2 0 1 0 0.01 0M6 18C14 18 4 8 12 8s0-3 5-3',
};
---
<figure class={`rider-compare ${compact ? 'is-compact' : ''} ${cls}`}>
  <div class="rc-head">
    <p class="label">Same rider. Different conditions.</p>
    <p class="rc-illus">illustrative scenario</p>
  </div>

  <div class="rc-cards">
    {riders.map((r) => (
      <div class="rc-card">
        <div class="rc-who">
          <svg class="rc-avatar" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="14" r="7" />
            <path d="M7 36c1.5-8 7-12 13-12s11.5 4 13 12" />
          </svg>
          <span class="rc-name head">Rider {r.id}</span>
        </div>
        <ul class="rc-conds" role="list">
          {r.conditions.map((c) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[c]} /></svg>
              {c}
            </li>
          ))}
        </ul>
        <div class="rc-score">
          <span class="rc-score-label">score</span>
          <span class="rc-score-num head">{r.score}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="rc-adjusted">
    <p class="rc-adj-label">After adjusting for circumstance</p>
    <div class="rc-bars">
      {riders.map((r, i) => (
        <div class="rc-bar-row">
          <span class="rc-bar-id">{r.id}</span>
          <span class="rc-bar"><span class="rc-bar-fill draw-bar" data-reveal style={`--w:${r.adjusted}%;--delay:${200 + i * 160}ms`}></span></span>
          <span class="rc-bar-num head">{r.adjusted}</span>
        </div>
      ))}
    </div>
  </div>

  <figcaption class="hand rc-note">same ability. different conditions.</figcaption>
</figure>

<style>
  .rider-compare {
    position: relative;
    background: var(--paper);
    border-radius: 4px;
    box-shadow: var(--shadow-paper);
    padding: var(--pad-panel);
  }
  .rc-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 20px; }
  .rc-illus {
    font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--grey);
    border: 1px dashed var(--line-strong); border-radius: 3px; padding: 3px 7px 2px;
  }
  .rc-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .rc-card { border: 1px solid var(--line); border-radius: 4px; padding: 16px 16px 14px; background: var(--cream); }
  .rc-who { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .rc-avatar { width: 30px; height: 30px; fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; }
  .rc-name { font-family: var(--font-body); font-size: 1.1rem; font-weight: 600; }
  .rc-conds { display: grid; gap: 6px; font-size: 0.875rem; color: var(--grey); }
  .rc-conds li { display: flex; align-items: center; gap: 8px; line-height: 1.3; }
  .rc-conds svg { width: 17px; height: 17px; flex: none; fill: none; stroke: var(--cobalt); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .rc-score { display: flex; align-items: baseline; justify-content: space-between; margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--line); }
  .rc-score-label { font-size: 0.8rem; color: var(--grey); }
  .rc-score-num { font-size: 2.25rem; font-weight: 650; letter-spacing: -0.03em; line-height: 1; }

  .rc-adjusted { margin-top: 20px; }
  .rc-adj-label { font-size: 0.8125rem; color: var(--grey); margin-bottom: 8px; }
  .rc-bars { display: grid; gap: 8px; }
  .rc-bar-row { display: grid; grid-template-columns: 18px 1fr 34px; align-items: center; gap: 10px; }
  .rc-bar-id { font-size: 0.8125rem; font-weight: 600; color: var(--grey); }
  .rc-bar { height: 10px; border-radius: 2px; background: rgba(23,23,23,0.06); overflow: hidden; }
  .rc-bar-fill { display: block; height: 100%; width: var(--w); background: var(--cobalt); border-radius: 2px; transform-origin: left; }
  :global(.js) .rc-bar-fill { transform: scaleX(0); transition: transform var(--t-diagram) var(--ease) var(--delay); }
  :global(.js) .rc-bar-fill.is-in { transform: scaleX(1); }
  .rc-bar-num { font-size: 1.05rem; font-weight: 600; text-align: right; }

  .rc-note { margin-top: 16px; transform: rotate(-1.5deg); }

  .is-compact .rc-card { padding: 14px; }
  .is-compact .rc-score-num { font-size: 2rem; }

  @media (max-width: 420px) {
    .rc-cards { grid-template-columns: 1fr; }
  }
</style>
