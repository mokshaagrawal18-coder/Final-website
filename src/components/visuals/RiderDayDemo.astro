---
/**
 * Rider fairness: a tiny experiment the reader can run.
 * Change the day (clear → traffic → traffic + rain). The rider never changes:
 * the score-only view gets harsher while the context view explains what actually happened.
 * Illustrative scenario only — not records from the dataset.
 */
const days = [
  {
    id: 'clear', label: 'Clear roads', icon: 'M12 7a5 5 0 1 0 0.01 0M12 1.5v2.5M12 20v2.5M1.5 12h2.5M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8',
    algo: { delivery: 'On track', completion: 'Completed', observed: 'Looks strong', verdict: 'Strong', tone: 'good', score: 86, note: 'On a clear day, the score looks fine.' },
    ctx: { traffic: 'Normal', weather: 'Clear', read: 'Performance looks strong.' },
    takeaway: ['Nothing surprising yet.', 'Now change the day. The rider stays exactly the same.'],
  },
  {
    id: 'traffic', label: 'Heavy traffic', icon: 'M3 16v-4l2-5h14l2 5v4zM3 16v2h3v-2M18 16v2h3v-2M7 13h.01M17 13h.01',
    algo: { delivery: 'Running late', completion: 'Completed', observed: 'Looks slower', verdict: 'Average', tone: 'mid', score: 78, note: 'The score starts blaming the rider for the road.' },
    ctx: { traffic: 'Heavy', weather: 'Clear', read: 'Same rider. The delay came from the traffic.' },
    takeaway: ['Same person, lower score.', 'Nothing about the rider changed. Only the road did.'],
  },
  {
    id: 'rain', label: 'Traffic + rain', icon: 'M6 14a4 4 0 0 1 .6-8 5.5 5.5 0 0 1 10.4 1.5A3.3 3.3 0 0 1 18 14zM8 17l-1 3M12 17l-1 3M16 17l-1 3',
    algo: { delivery: 'Late', completion: 'Completed', observed: 'Looks weak', verdict: 'Weak', tone: 'bad', score: 72, note: 'Now the rider looks like the problem.' },
    ctx: { traffic: 'Heavy', weather: 'Rain', read: 'Still the same rider. Harder conditions, not worse performance.' },
    takeaway: ['That gap is what I set out to measure.', 'A score can punish circumstances as if they were performance.'],
  },
];
const first = days[0];
---
<div class="rdd" data-demo>
  <div class="dm-head">
    <div>
      <p class="dm-kicker">Illustrative scenario</p>
      <p class="dm-title">Same rider. Change the day.</p>
      <p class="dm-sub">Pick a day. The rider stays exactly the same — only the road and the weather change.</p>
    </div>
    <p class="hand dm-try" data-try aria-hidden="true">try all three →</p>
  </div>

  <div class="dm-days" role="group" aria-label="Choose the day's conditions">
    {days.map((d, i) => (
      <button type="button" class="dm-day" data-day={d.id} aria-pressed={i === 0 ? 'true' : 'false'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={d.icon} /></svg> {d.label}
      </button>
    ))}
  </div>

  <div class="dm-panels" aria-live="polite">
    <div class="dm-panel dm-algo" data-tone={first.algo.tone}>
      <div class="dm-ph">
        <p class="dm-plabel">Score-only view</p>
        <span class="dm-verdict" data-f="verdict">{first.algo.verdict}</span>
      </div>
      <p class="dm-ptitle">What the algorithm sees</p>
      <dl class="dm-rows">
        <div><dt>Delivery time</dt><dd data-f="delivery">{first.algo.delivery}</dd></div>
        <div><dt>Completion</dt><dd data-f="completion">{first.algo.completion}</dd></div>
        <div><dt>Observed performance</dt><dd data-f="observed">{first.algo.observed}</dd></div>
      </dl>
      <div class="dm-score" aria-hidden="true">
        <span class="dm-bar"><span data-f="bar" style={`--w:${first.algo.score}%`}></span></span>
        <span class="dm-num" data-f="score">{first.algo.score}</span>
      </div>
      <p class="dm-note" data-f="note">{first.algo.note}</p>
    </div>

    <span class="dm-rider" aria-hidden="true">
      <svg viewBox="0 0 48 48"><circle cx="13" cy="35" r="5" /><circle cx="36" cy="35" r="5" /><path d="M13 35 H 22 L 27 24 H 33 M 33 24 L 36 35 M 22 24 H 15 M 30 18 h 5" /><circle cx="27" cy="12" r="3.5" /></svg>
      <span>same<br />rider</span>
    </span>

    <div class="dm-panel dm-ctx">
      <p class="dm-plabel">Add context</p>
      <p class="dm-ptitle">What else was happening?</p>
      <dl class="dm-rows">
        <div><dt>Traffic</dt><dd data-f="traffic">{first.ctx.traffic}</dd></div>
        <div><dt>Weather</dt><dd data-f="weather">{first.ctx.weather}</dd></div>
        <div><dt>Rider</dt><dd>Same rider</dd></div>
      </dl>
      <div class="dm-read">
        <p class="dm-plabel">Context-adjusted read</p>
        <p class="dm-read-text" data-f="read">{first.ctx.read}</p>
      </div>
    </div>
  </div>

  <div class="dm-take">
    <p class="dm-take-1" data-f="take1">{first.takeaway[0]}</p>
    <p class="dm-take-2" data-f="take2">{first.takeaway[1]}</p>
  </div>
  <script type="application/json" data-days set:html={JSON.stringify(days)} />
</div>

<script>
  type Day = { id: string; algo: Record<string, any>; ctx: Record<string, string>; takeaway: string[] };
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((demo) => {
    const json = demo.querySelector('[data-days]');
    if (!demo || !json) return;
    const days: Day[] = JSON.parse(json.textContent || '[]');
    const buttons = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-day]'));
    const algo = demo.querySelector<HTMLElement>('.dm-algo')!;
    const f = (k: string) => demo.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
    const seen = new Set(['clear']);

    const show = (id: string) => {
      const d = days.find((x) => x.id === id);
      if (!d) return;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.day === id)));
      algo.dataset.tone = d.algo.tone;
      for (const k of ['delivery', 'completion', 'observed', 'verdict', 'note']) f(k).textContent = d.algo[k];
      f('score').textContent = String(d.algo.score);
      f('bar').style.setProperty('--w', `${d.algo.score}%`);
      f('traffic').textContent = d.ctx.traffic;
      f('weather').textContent = d.ctx.weather;
      f('read').textContent = d.ctx.read;
      f('take1').textContent = d.takeaway[0];
      f('take2').textContent = d.takeaway[1];
      // a quick flash on whatever changed, so the eye follows it
      demo.classList.remove('is-changing'); void demo.offsetWidth; demo.classList.add('is-changing');
      seen.add(id);
      if (seen.size === days.length) demo.querySelector<HTMLElement>('[data-try]')!.textContent = 'that’s the gap ✓';
    };
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.day!)));
  });
</script>

<style>
  .rdd { padding: clamp(22px, 2.6vw, 34px); background: linear-gradient(180deg, #FCFAF5, #F8F4EA); border-radius: 8px; box-shadow: 0 1px 0 rgba(23, 23, 23, 0.04), 0 18px 40px -26px rgba(60, 45, 20, 0.45); }

  .dm-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .dm-kicker { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--grey); }
  .dm-title { margin-top: 4px; font-family: var(--font-head); font-size: 1.45rem; line-height: 1.15; }
  .dm-sub { margin-top: 4px; font-size: 0.85rem; color: var(--grey); }
  .dm-try { flex: none; margin-top: 6px; font-size: 0.95rem; color: var(--cobalt); transform: rotate(-3deg); }

  .dm-days { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .dm-day {
    display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 16px;
    font-size: 0.88rem; font-weight: 500; color: var(--ink);
    background: var(--paper); border: 1px solid var(--line-strong); border-radius: 999px;
    transition: background-color var(--t-micro), border-color var(--t-micro), transform 120ms var(--ease);
  }
  .dm-day svg { width: 16px; height: 16px; fill: none; stroke: var(--cobalt); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .dm-day:hover { border-color: var(--cobalt-line); }
  .dm-day:active { transform: scale(0.97); }
  .dm-day[aria-pressed='true'] { background: #E3EAFB; border-color: var(--cobalt); color: var(--ink); }

  .dm-panels { display: grid; grid-template-columns: minmax(0, 1fr) 64px minmax(0, 1fr); align-items: center; margin-top: 16px; }
  .dm-panel { align-self: stretch; padding: 16px 18px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; }
  .dm-ph { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .dm-plabel { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey); }
  .dm-ptitle { margin-top: 4px; font-weight: 600; font-size: 0.98rem; }
  .dm-rows { margin: 10px 0 0; }
  .dm-rows div { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; font-size: 0.85rem; border-top: 1px solid var(--line); }
  .dm-rows dt { color: #4a4741; }
  .dm-rows dd { margin: 0; font-weight: 600; text-align: right; transition: color 300ms var(--ease); }

  .dm-verdict { padding: 3px 10px; font-size: 0.75rem; font-weight: 600; border-radius: 999px; transition: background-color 300ms, color 300ms; }
  .dm-algo[data-tone='good'] .dm-verdict { background: #E3EAFB; color: var(--cobalt); }
  .dm-algo[data-tone='mid'] .dm-verdict { background: #FBEBC0; color: #8A6410; }
  .dm-algo[data-tone='bad'] .dm-verdict { background: #F7DCD7; color: #A9372A; }
  .dm-algo[data-tone='bad'] [data-f='observed'], .dm-algo[data-tone='bad'] [data-f='delivery'] { color: #A9372A; }
  .dm-algo[data-tone='mid'] [data-f='delivery'] { color: #8A6410; }

  .dm-score { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; margin-top: 10px; }
  .dm-bar { height: 6px; border-radius: 3px; background: rgba(23, 23, 23, 0.07); overflow: hidden; }
  .dm-bar span { display: block; height: 100%; width: var(--w); background: var(--cobalt); border-radius: 3px; transition: width 600ms var(--ease), background-color 300ms; }
  .dm-algo[data-tone='mid'] .dm-bar span { background: #D9A521; }
  .dm-algo[data-tone='bad'] .dm-bar span { background: var(--red); }
  .dm-num { font-family: var(--font-head); font-size: 1.3rem; font-variant-numeric: tabular-nums; }
  .dm-note { margin-top: 8px; font-size: 0.8rem; color: var(--grey); }

  .dm-rider { display: flex; flex-direction: column; align-items: center; gap: 4px; font-family: var(--font-hand); font-size: 0.78rem; line-height: 1; text-align: center; color: var(--cobalt); }
  .dm-rider svg { width: 44px; height: 44px; padding: 7px; border-radius: 50%; background: var(--paper); border: 1px solid var(--line-strong); }
  .dm-rider path, .dm-rider circle { fill: none; stroke: var(--cobalt); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .dm-read { margin-top: 12px; padding: 12px 14px; background: #EEF2FC; border-radius: 8px; }
  .dm-read-text { margin-top: 4px; font-weight: 600; font-size: 0.9rem; line-height: 1.4; }

  .dm-take { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); }
  .dm-take-1 { font-weight: 600; font-size: 0.92rem; color: #3b3833; }
  .dm-take-2 { margin-top: 2px; font-size: 0.85rem; color: var(--grey); }

  /* change cue: changed text fades in */
  :global(.js) .is-changing [data-f] { animation: dm-in 380ms var(--ease); }
  @keyframes dm-in { from { opacity: 0.15; } to { opacity: 1; } }

  @media (max-width: 620px) {
    .dm-panels { grid-template-columns: 1fr; gap: 10px; }
    .dm-rider { flex-direction: row; justify-self: center; }
    .dm-rider br { display: none; }
    .dm-head { flex-direction: column; gap: 4px; }
    .dm-try { margin-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .is-changing [data-f] { animation: none; }
    .dm-bar span { transition: none; }
  }
</style>
