---
/** A neutral, abstract marketplace row. Not a real listing — shapes only. */
const items = [
  { stars: 3, price: 62, lines: [70, 48] },
  { stars: 4, price: 48, lines: [80, 56] },
  { stars: 5, price: 54, lines: [76, 40], hi: true },
  { stars: 3, price: 70, lines: [64, 52] },
  { stars: 4, price: 44, lines: [72, 36] },
];
---
<figure class="shelf" data-reveal>
  <figcaption class="visually-hidden">An abstract row of five product listings. One listing is highlighted, with notes on price, reviews and bundle.</figcaption>
  <p class="sh-illus" aria-hidden="true">illustration</p>
  <div class="sh-search" aria-hidden="true">
    <svg viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5.5" /><path d="M13 13l4 4" /></svg>
    <span class="sh-q"></span>
  </div>
  <ul class="sh-row" role="list" aria-hidden="true">
    {items.map((it, i) => (
      <li class:list={['sh-card', { 'is-hi': it.hi }]} style={`--i:${i}`}>
        <span class="sh-thumb">
          <svg viewBox="0 0 40 40"><path d="M20 34V18M20 22c-6 0-9-4-9-9 5 0 9 3 9 9zM20 20c5 0 8-3 8-8-5 0-8 3-8 8zM13 34h14" /></svg>
        </span>
        <span class="sh-line" style={`width:${it.lines[0]}%`}></span>
        <span class="sh-line sh-line--2" style={`width:${it.lines[1]}%`}></span>
        <span class="sh-stars">{Array.from({ length: 5 }).map((_, s) => <i class:list={{ on: s < it.stars }}></i>)}</span>
        <span class="sh-price" style={`width:${it.price * 0.5}%`}></span>
        {it.hi && <span class="sh-bundle">+ bundle</span>}
      </li>
    ))}
  </ul>
  <div class="sh-notes hand" aria-hidden="true">
    <span>price</span><span>reviews</span><span>positioning</span>
  </div>
</figure>
<style>
  .shelf { position: relative; padding: 24px; background: var(--paper); border-radius: 4px; box-shadow: var(--shadow-paper); }
  .sh-illus { position: absolute; top: 20px; right: 22px; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--grey); border: 1px dashed var(--line-strong); border-radius: 3px; padding: 3px 7px 2px; }
  .sh-search { display: flex; align-items: center; gap: 10px; width: min(360px, 70%); height: 36px; padding: 0 12px; border: 1px solid var(--line-strong); border-radius: 18px; margin-bottom: 20px; }
  .sh-search svg { width: 16px; fill: none; stroke: var(--grey); stroke-width: 1.6; stroke-linecap: round; }
  .sh-q { height: 6px; width: 45%; border-radius: 3px; background: var(--line); }
  .sh-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .sh-card { position: relative; display: grid; gap: 7px; padding: 10px 10px 14px; border: 1px solid var(--line); border-radius: 4px; background: var(--cream); transition: transform 400ms var(--ease), box-shadow 400ms var(--ease); }
  .sh-thumb { aspect-ratio: 1; border-radius: 3px; background: rgba(23,23,23,0.045); display: grid; place-items: center; margin-bottom: 4px; }
  .sh-thumb svg { width: 44%; fill: none; stroke: rgba(23,23,23,0.28); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .sh-line { height: 6px; border-radius: 3px; background: rgba(23,23,23,0.14); }
  .sh-line--2 { background: rgba(23,23,23,0.08); }
  .sh-stars { display: flex; gap: 3px; margin-top: 2px; }
  .sh-stars i { width: 7px; height: 7px; border-radius: 50%; background: rgba(23,23,23,0.1); }
  .sh-stars i.on { background: rgba(23,23,23,0.35); }
  .sh-price { height: 8px; border-radius: 2px; background: rgba(23,23,23,0.22); }
  .sh-bundle { position: absolute; top: 8px; left: 8px; font-size: 0.68rem; font-weight: 600; background: var(--yellow); padding: 2px 6px; border-radius: 2px; }
  .sh-card.is-hi { border-color: var(--cobalt); background: var(--paper); }
  .sh-card.is-hi .sh-stars i.on { background: var(--cobalt); }
  .sh-card.is-hi .sh-thumb svg { stroke: var(--cobalt); }
  :global(.js) .shelf.is-in .sh-card.is-hi { transform: translateY(-6px); box-shadow: var(--shadow-lift); transition-delay: 500ms; }
  .sh-notes { display: flex; justify-content: center; gap: 22px; margin-top: 16px; font-size: 1.15rem; }
  .sh-notes span:nth-child(2) { transform: rotate(-3deg); }
  @media (max-width: 640px) {
    .sh-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sh-card:nth-child(4), .sh-card:nth-child(5) { display: none; }
    .sh-search { width: 100%; }
    .sh-illus { position: static; display: inline-block; margin-bottom: 12px; }
  }
</style>
