---
import { site } from '../data/site';

const links = [
  { label: 'Email', href: `mailto:${site.email}` },
  site.linkedin && { label: 'LinkedIn', href: site.linkedin, external: true },
  site.github && { label: 'GitHub', href: site.github, external: true },
  site.resume && { label: 'Résumé', href: site.resume, external: true },
].filter(Boolean) as { label: string; href: string; external?: boolean }[];
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="buddy" data-buddy>
      <svg class="buddy-face" viewBox="0 0 64 56" aria-hidden="true">
        <circle class="bf-head" cx="30" cy="30" r="20" />
        <g class="bf-eyes"><ellipse cx="23.5" cy="27" rx="2" ry="2.6" /><ellipse cx="36.5" cy="27" rx="2" ry="2.6" /></g>
        <circle class="bf-cheek" cx="19" cy="34" r="3" /><circle class="bf-cheek" cx="41" cy="34" r="3" />
        <path class="bf-smile" d="M24 35.5 C 27 39, 33 39, 36 35.5" />
        <g class="bf-hand"><path d="M50 30 l4-8 M53 31 l5-6 M54 34 l6-3 M49 28 c-2 4 -1 9 3 10 c3 1 6-1 7-3" /></g>
      </svg>
      <p class="buddy-say hand" data-say aria-live="polite"></p>
      <span class="buddy-pops" data-pops aria-hidden="true"></span>
    </div>
    <p class="footer-main">Thanks for looking a little closer.</p>
    <button type="button" class="wave-btn hand" data-wave>wave back <span aria-hidden="true">✋</span></button>
    <ul class="footer-links" role="list">
      {links.map((l) => (
        <li>
          <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}</a>
        </li>
      ))}
    </ul>
    <p class="footer-built">
      built with too many tabs open.
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M8.5 14.5 C 10 16.5, 14 16.5, 15.5 14.5 M 9 9.5 h.01 M 15 9.5 h.01" /></svg>
    </p>
    <p class="footer-copy">© 2026 Moksha Agrawal</p>

    <a href="#top" class="to-top">
      <svg viewBox="0 0 16 24" aria-hidden="true"><path d="M8 22 V 3 M 2 9 L 8 2 L 14 9" /></svg>
      <span>Back to top</span>
    </a>
  </div>
</footer>

<script>
  const lines = [
    'hi! ♡',
    'okay, now we’re friends',
    'you came back :)',
    'this made my day, honestly',
    'still here? me too.',
    'go on, the email link is right there ↓',
    'okay last one… (it’s not)',
  ];
  document.querySelectorAll<HTMLElement>('[data-buddy]').forEach((buddy) => {
    const btn = buddy.parentElement?.querySelector<HTMLButtonElement>('[data-wave]');
    const say = buddy.querySelector<HTMLElement>('[data-say]')!;
    const pops = buddy.querySelector<HTMLElement>('[data-pops]')!;
    if (!btn) return;
    let n = 0;
    const colors = ['var(--cobalt)', 'var(--yellow)', 'var(--red)'];
    btn.addEventListener('click', () => {
      say.textContent = lines[n % lines.length];
      n++;
      buddy.classList.remove('is-waving'); void buddy.offsetWidth; buddy.classList.add('is-waving');
      say.classList.remove('is-on'); void say.offsetWidth; say.classList.add('is-on');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      for (let i = 0; i < 6; i++) {
        const h = document.createElement('span');
        h.className = 'pop';
        h.textContent = i % 3 === 2 ? '✦' : '♥';
        h.style.setProperty('--x', `${Math.round((Math.random() - 0.5) * 90)}px`);
        h.style.setProperty('--r', `${Math.round((Math.random() - 0.5) * 50)}deg`);
        h.style.setProperty('--d', `${i * 60}ms`);
        h.style.color = colors[i % 3];
        pops.appendChild(h);
        setTimeout(() => h.remove(), 1500);
      }
    });
  });
</script>

<style>
  .site-footer { margin-top: auto; padding: 8px 0 24px; }
  .footer-inner { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; border-top: 1px solid var(--line); padding-top: 40px; }

  /* a tiny doodle who waves back */
  .buddy { position: relative; width: 64px; height: 56px; }
  .buddy-face { width: 64px; height: 56px; overflow: visible; transition: transform 300ms var(--ease); }
  .bf-head { fill: var(--paper); stroke: var(--ink); stroke-width: 1.6; }
  .bf-eyes { fill: var(--ink); transform-origin: 30px 27px; animation: bf-blink 4.5s infinite; }
  .bf-cheek { fill: #F4B9AE; opacity: 0.7; }
  .bf-smile, .bf-hand path { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .bf-hand { transform-origin: 50px 38px; opacity: 0; transform: rotate(20deg); transition: opacity 200ms; }
  .site-footer:hover .buddy-face { transform: rotate(-6deg); }
  .buddy.is-waving .bf-hand { opacity: 1; animation: bf-wave 900ms var(--ease); }
  .buddy.is-waving .bf-smile { d: path('M23 34.5 C 26 41, 34 41, 37 34.5'); }
  @keyframes bf-blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(0.1); } }
  @keyframes bf-wave { 0% { transform: rotate(20deg); } 20% { transform: rotate(-18deg); } 40% { transform: rotate(16deg); } 60% { transform: rotate(-14deg); } 80% { transform: rotate(10deg); } 100% { transform: rotate(0); } }

  .buddy-say {
    position: absolute; left: calc(100% + 6px); top: -6px; white-space: nowrap;
    padding: 4px 12px; font-size: 1rem; color: var(--cobalt);
    background: var(--paper); border: 1px solid var(--line-strong); border-radius: 14px 14px 14px 3px;
    opacity: 0; transform: translateY(4px) rotate(-2deg); pointer-events: none;
  }
  .buddy-say:empty { display: none; }
  .buddy-say.is-on { animation: bf-say 2.6s var(--ease) forwards; }
  @keyframes bf-say { 0% { opacity: 0; transform: translateY(4px) rotate(-2deg); } 12%, 82% { opacity: 1; transform: translateY(0) rotate(-2deg); } 100% { opacity: 0; transform: translateY(-4px) rotate(-2deg); } }

  .buddy-pops { position: absolute; left: 50%; top: 10px; pointer-events: none; }
  .buddy-pops :global(.pop) { position: absolute; left: 0; top: 0; font-size: 14px; line-height: 1; opacity: 0; animation: bf-pop 1.2s var(--ease) var(--d) forwards; }
  @keyframes bf-pop {
    0% { opacity: 0; transform: translate(-50%, 0) scale(0.4); }
    20% { opacity: 1; }
    100% { opacity: 0; transform: translate(calc(-50% + var(--x)), -70px) rotate(var(--r)) scale(1); }
  }

  .wave-btn {
    min-height: 36px; padding: 2px 16px; margin-top: -2px;
    font-size: 1rem; color: var(--ink); background: rgba(242, 200, 75, 0.35);
    border: 1px dashed rgba(23, 23, 23, 0.25); border-radius: 999px; transform: rotate(-1.5deg);
    transition: background-color var(--t-micro), transform 160ms var(--ease);
  }
  .wave-btn span { display: inline-block; transition: transform 200ms var(--ease); }
  .wave-btn:hover { background: var(--yellow); }
  .wave-btn:hover span { transform: rotate(-18deg); }
  .wave-btn:active { transform: rotate(-1.5deg) scale(0.96); }
  .footer-main { font-family: var(--font-serif-text); font-weight: 600; font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem); letter-spacing: -0.005em; color: var(--ink); }

  .footer-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; }
  .footer-links li + li::before { content: '·'; color: var(--grey); margin: 0 12px; }
  .footer-links a {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 0.95rem; color: #3b3833;
    background-image: linear-gradient(var(--cobalt), var(--cobalt));
    background-size: 0 1.5px; background-position: 0 78%; background-repeat: no-repeat;
    transition: background-size var(--t-micro) var(--ease), color var(--t-micro);
  }
  .footer-links a:hover, .footer-links a:focus-visible { color: var(--cobalt); background-size: 100% 1.5px; }

  .footer-built { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-hand-print); font-size: 1rem; color: var(--cobalt); transform: rotate(-1deg); }
  .footer-built svg { width: 20px; height: 20px; }
  .footer-built path, .footer-built circle { fill: none; stroke: var(--cobalt); stroke-width: 1.5; stroke-linecap: round; }
  .footer-copy { margin-top: 6px; font-size: 0.78rem; color: var(--grey); }

  .to-top {
    position: absolute; right: var(--gutter); top: 50%; transform: translateY(-30%);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    min-width: 44px; min-height: 44px; padding: 4px;
    font-size: 0.85rem; color: var(--ink);
  }
  .to-top svg { width: 14px; height: 22px; transition: transform var(--t-micro) var(--ease); }
  .to-top path { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .to-top:hover { color: var(--cobalt); }
  .to-top:hover svg { transform: translateY(-3px); }

  @media (prefers-reduced-motion: reduce) {
    .bf-eyes, .buddy.is-waving .bf-hand { animation: none; }
    .buddy-face { transition: none; }
  }
  @media (max-width: 640px) {
    .buddy-say { left: -90px; right: -90px; top: -40px; margin: 0 auto; width: auto; max-width: max-content; white-space: normal; text-align: center; }
    .to-top { position: static; transform: none; margin-top: 14px; flex-direction: row; }
  }
</style>
