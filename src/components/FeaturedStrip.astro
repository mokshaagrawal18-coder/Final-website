---
/**
 * Featured project, kept light: the pitch on the left and a quiet hint of the idea on the right
 * (same rider, three days, three scores). The hands-on version lives on the project page.
 * Illustrative scenario only — not records from the dataset.
 */
const days = [
  { label: 'clear roads', score: 86, tone: 'good', icon: 'M12 7a5 5 0 1 0 0.01 0M12 1.5v2.5M12 20v2.5M1.5 12h2.5M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8' },
  { label: 'heavy traffic', score: 78, tone: 'mid', icon: 'M3 16v-4l2-5h14l2 5v4zM3 16v2h3v-2M18 16v2h3v-2M7 13h.01M17 13h.01' },
  { label: 'traffic + rain', score: 72, tone: 'bad', icon: 'M6 14a4 4 0 0 1 .6-8 5.5 5.5 0 0 1 10.4 1.5A3.3 3.3 0 0 1 18 14zM8 17l-1 3M12 17l-1 3M16 17l-1 3' },
];
---
<section class="fstrip" aria-labelledby="fs-title">
  <div class="fs-card">
    <p class="fs-tape">Featured project</p>

    <div class="fs-pitch">
      <h2 class="fs-title" id="fs-title"><a href="/projects/rider-fairness/">Is the Algorithm Being Fair to Riders?</a></h2>
      <p class="fs-q">Can a score mistake difficult conditions for poor performance?</p>
      <p class="fs-copy">I tested that across 15,000 deliveries, then built a condition-adjusted alternative.</p>
      <p class="fs-ev">15,000 records <span aria-hidden="true">·</span> 99.9% model fit <span aria-hidden="true">·</span> Python</p>
      <a href="/projects/rider-fairness/#try" class="fs-cta">Try the experiment <span aria-hidden="true">→</span></a>
    </div>

    <a href="/projects/rider-fairness/#try" class="fs-hint" aria-label="Same rider on three different days: the score drops from 86 to 72. Try it on the project page.">
      <span class="fs-hint-head"><span class="hand">same rider, three days</span><span class="fs-illus">illustrative</span></span>
      <span class="fs-days" aria-hidden="true">
        {days.map((d, i) => (
          <>
            {i > 0 && <span class="fs-sep">→</span>}
            <span class="fs-day" data-tone={d.tone}>
              <svg viewBox="0 0 24 24"><path d={d.icon} /></svg>
              <span class="fs-num">{d.score}</span>
              <span class="fs-lbl">{d.label}</span>
            </span>
          </>
        ))}
      </span>
      <span class="fs-hint-foot" aria-hidden="true">The rider didn’t change. The score did.</span>
    </a>
  </div>

  <a href="#experience" class="fs-scroll">
    <svg viewBox="0 0 24 14" aria-hidden="true"><path d="M3 3l9 8 9-8" /></svg>
    <span class="hand">scroll to explore</span>
  </a>
</section>

<style>
  .fstrip { width: min(100% - 2 * var(--gutter), 1340px); margin: 0 auto; position: relative; }
  .fs-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 3.5vw, 56px);
    align-items: center;
    padding: clamp(36px, 3.4vw, 48px) clamp(22px, 3vw, 44px) clamp(24px, 2.4vw, 34px);
    background: linear-gradient(180deg, #FCFAF5, #F8F4EA);
    border-radius: 8px;
    box-shadow: 0 1px 0 rgba(23, 23, 23, 0.04), 0 18px 40px -26px rgba(60, 45, 20, 0.45);
  }

  /* masking-tape label */
  .fs-tape {
    position: absolute; left: 18px; top: -14px;
    padding: 6px 18px 5px;
    font-family: var(--font-hand); font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--ink); background: rgba(244, 222, 160, 0.9);
    transform: rotate(-3deg);
    clip-path: polygon(1% 8%, 4% 0, 97% 4%, 100% 12%, 98.5% 50%, 100% 90%, 96% 100%, 3% 96%, 0 88%, 1.5% 50%);
  }

  /* left: the pitch */
  .fs-pitch { padding-top: 6px; }
  .fs-title { font-size: clamp(1.7rem, 1.3rem + 1.1vw, 2.35rem); line-height: 1.1; }
  .fs-title a { color: var(--ink); transition: color var(--t-micro); }
  .fs-title a:hover { color: var(--cobalt); }
  .fs-q { margin-top: 14px; font-size: 1.02rem; line-height: 1.45; color: var(--cobalt); font-weight: 500; }
  .fs-copy { margin-top: 12px; font-size: 0.95rem; line-height: 1.55; color: #4a4741; }
  .fs-ev { margin-top: 14px; font-size: 0.82rem; font-weight: 600; color: var(--cobalt); }
  .fs-ev span { color: var(--grey); font-weight: 400; margin: 0 4px; }
  .fs-cta { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; margin-top: 14px; font-weight: 500; font-size: 0.95rem; color: var(--ink); border-bottom: 1.5px solid var(--yellow); }
  .fs-cta span { color: var(--cobalt); transition: transform var(--t-micro) var(--ease); }
  .fs-cta:hover span { transform: translateX(4px); }

  /* right: a quiet hint, not the experiment itself */
  .fs-hint { display: block; padding: 20px 22px 18px; color: var(--ink); background: var(--paper); border: 1px solid var(--line); border-radius: 10px; transition: border-color var(--t-micro), transform var(--t-micro) var(--ease); }
  .fs-hint:hover { border-color: var(--cobalt-line); transform: translateY(-2px); }
  .fs-hint-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .fs-hint-head .hand { font-size: 1.05rem; color: var(--cobalt); }
  .fs-illus { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey); }
  .fs-days { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: 14px; }
  .fs-day { display: flex; flex-direction: column; align-items: center; gap: 4px; flex: 1; }
  .fs-day svg { width: 22px; height: 22px; fill: none; stroke: var(--grey); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .fs-num { font-family: var(--font-head); font-size: 1.9rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .fs-day[data-tone='good'] .fs-num { color: var(--cobalt); }
  .fs-day[data-tone='mid'] .fs-num { color: #B58614; }
  .fs-day[data-tone='bad'] .fs-num { color: #A9372A; }
  .fs-lbl { font-size: 0.75rem; color: var(--grey); }
  .fs-sep { color: var(--line-strong); font-size: 1.1rem; }
  .fs-hint-foot { display: block; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 0.88rem; font-weight: 600; color: #3b3833; }

  /* scroll cue */
  .fs-scroll { display: flex; flex-direction: column; align-items: center; width: fit-content; min-height: 44px; margin: 6px auto 0; }
  .fs-scroll svg { width: 22px; height: 14px; }
  .fs-scroll path { fill: none; stroke: var(--grey); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: stroke var(--t-micro); }
  .fs-scroll .hand { font-size: 0.95rem; color: var(--grey); transition: color var(--t-micro); }
  .fs-scroll:hover path { stroke: var(--cobalt); }
  .fs-scroll:hover .hand { color: var(--cobalt); }

  @media (max-width: 900px) {
    .fs-card { grid-template-columns: 1fr; }
    .fstrip { margin-top: 56px; }
  }
</style>
