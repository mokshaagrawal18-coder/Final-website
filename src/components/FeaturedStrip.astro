---
/**
 * Featured project card: tape label, title, a small "how fair?" slider and a taped photo note.
 * The slider is a teaser for the project, not a result: it moves a 0–1 fairness weight
 * between the score as given ("less fair") and the circumstance-adjusted score ("more fair").
 */
const start = 0.62;
const ticks = 8;
---
<section class="fstrip" aria-labelledby="fs-title">
  <div class="fs-card" data-fairness>
    <p class="fs-tape">Featured project</p>

    <h2 class="fs-title" id="fs-title">
      <a href="/projects/rider-fairness/">
        <span class="fs-title-text">Is the Algorithm<br /> Being Fair to Riders?</span>
        <span class="fs-arrow" aria-hidden="true">
          <svg viewBox="0 0 40 20"><path d="M2 10h34M27 2l9 8-9 8" /></svg>
        </span>
      </a>
    </h2>
    <div class="fs-detail">
      <p class="fs-copy">I reverse-engineered rider scoring across 15,000 delivery records to understand how traffic, weather, and experience were shaping performance scores — then built a condition-adjusted Fair Score to separate performance from circumstance.</p>
      <ul class="fs-ev" role="list" aria-label="Evidence"><li>15,000 records</li><li>99.9% model fit</li><li>Python</li></ul>
    </div>

    <span class="fs-divider" aria-hidden="true"></span>

    <div class="fs-slider">
      <p class="fs-illus">illustrative scenario</p>
      <label for="fairness" class="visually-hidden">How fair is the score? Drag between less fair and more fair.</label>
      <div class="fs-range" style={`--t:${start}`} data-track>
        <output class="fs-value" for="fairness" data-value>{start.toFixed(2)}</output>
        <span class="fs-ticks" aria-hidden="true">
          {Array.from({ length: ticks + 1 }).map((_, i) => <i style={`left:${(i / ticks) * 100}%`}></i>)}
        </span>
        <input type="range" id="fairness" min="0" max="1" step="0.01" value={start} data-range />
      </div>
      <p class="fs-ends hand" aria-hidden="true"><span>Less fair</span><span>More fair</span></p>
    </div>

    <figure class="fs-photo" aria-hidden="true">
      <span class="fs-photo-tape"></span>
      <svg viewBox="0 0 160 190" class="fs-night">
        <defs>
          <linearGradient id="fsSky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#1b1b1b" /><stop offset="0.55" stop-color="#2e2e2e" /><stop offset="1" stop-color="#151515" />
          </linearGradient>
          <filter id="fsBlur" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="2.4" /></filter>
          <filter id="fsSoft"><feGaussianBlur stdDeviation="0.7" /></filter>
        </defs>
        <rect width="160" height="190" fill="url(#fsSky)" />
        <!-- buildings + lit windows -->
        <g fill="#3a3a3a"><rect x="0" y="10" width="44" height="110" /><rect x="96" y="0" width="64" height="118" /></g>
        <g fill="#cfcfcf" filter="url(#fsSoft)" opacity="0.75">
          <rect x="8" y="22" width="10" height="7" /><rect x="24" y="22" width="10" height="7" /><rect x="8" y="40" width="10" height="7" />
          <rect x="24" y="58" width="10" height="7" /><rect x="106" y="14" width="12" height="8" /><rect x="128" y="14" width="12" height="8" />
          <rect x="106" y="34" width="12" height="8" /><rect x="128" y="54" width="12" height="8" /><rect x="106" y="74" width="12" height="8" />
        </g>
        <rect x="58" y="20" width="3" height="120" fill="#4a4a4a" />
        <!-- motion streaks -->
        <g filter="url(#fsBlur)">
          <rect x="-10" y="96" width="120" height="5" fill="#e8e8e8" opacity="0.55" />
          <rect x="20" y="112" width="150" height="3" fill="#ffffff" opacity="0.4" />
          <rect x="-20" y="128" width="110" height="4" fill="#bdbdbd" opacity="0.45" />
        </g>
        <rect x="0" y="140" width="160" height="50" fill="#232323" />
        <rect x="0" y="152" width="160" height="2" fill="#5a5a5a" opacity="0.6" />
        <!-- rider on a scooter -->
        <g fill="#0c0c0c">
          <circle cx="104" cy="104" r="7" />
          <path d="M98 110 C 92 120, 94 132, 100 138 L 116 138 L 113 126 L 120 122 L 112 112 Z" />
          <path d="M84 140 C 86 128, 104 126, 124 132 L 132 128 L 136 132 L 128 146 L 90 150 Z" />
          <circle cx="92" cy="152" r="9" /><circle cx="128" cy="152" r="9" />
        </g>
        <g fill="#2a2a2a"><circle cx="92" cy="152" r="4" /><circle cx="128" cy="152" r="4" /></g>
        <circle cx="137" cy="134" r="3" fill="#fff" filter="url(#fsSoft)" />
      </svg>
    </figure>

    <p class="fs-note hand" aria-hidden="true">
      Same <br />routes. <br />different <br />outcomes?
      <svg viewBox="0 0 40 30"><path d="M30 2 C 32 16, 24 24, 6 25 M12 19 L5 25 L13 29" /></svg>
    </p>
  </div>

  <a href="#experience" class="fs-scroll">
    <svg viewBox="0 0 24 14" aria-hidden="true"><path d="M3 3l9 8 9-8" /></svg>
    <span class="hand">scroll to explore</span>
  </a>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-fairness]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('[data-range]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const value = root.querySelector<HTMLElement>('[data-value]')!;
    const update = () => {
      const t = Number(range.value);
      track.style.setProperty('--t', String(t));
      value.textContent = t.toFixed(2);
      range.setAttribute('aria-valuetext', `${t.toFixed(2)}, ${t < 0.34 ? 'less fair' : t > 0.66 ? 'more fair' : 'in between'}`);
    };
    range.addEventListener('input', update);
    update();
  });
</script>

<style>
  .fstrip { width: min(100% - 2 * var(--gutter), 1340px); margin: 0 auto; container-type: inline-size; position: relative; }
  .fs-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 36fr) 1px minmax(0, 32fr) minmax(0, 13fr) minmax(0, 8fr);
    column-gap: 2.6cqw;
    align-items: center;
    min-height: 14.5cqw;
    padding: 1.5cqw 2.4cqw 1.5cqw 5.2cqw;
    background: linear-gradient(180deg, #FCFAF5, #F8F4EA);
    border-radius: 6px;
    box-shadow: 0 1px 0 rgba(23, 23, 23, 0.04), 0 18px 40px -26px rgba(60, 45, 20, 0.45);
  }

  /* masking-tape label */
  .fs-tape {
    position: absolute; left: 0.3cqw; top: -1.6cqw;
    padding: 0.55cqw 1.6cqw 0.45cqw;
    font-family: var(--font-hand-print); font-size: max(10px, 0.85cqw); letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ink);
    background: rgba(244, 222, 160, 0.85);
    transform: rotate(-4deg);
    clip-path: polygon(1% 8%, 4% 0, 97% 4%, 100% 12%, 98.5% 50%, 100% 90%, 96% 100%, 3% 96%, 0 88%, 1.5% 50%);
  }

  .fs-title { font-family: var(--font-serif-display); font-weight: 400; letter-spacing: -0.015em; }
  .fs-title a { display: inline-flex; align-items: flex-end; gap: 1.6cqw; color: var(--ink); }
  .fs-title-text { font-size: max(22px, 3.05cqw); line-height: 1.1; }
  .fs-arrow { display: inline-block; width: max(26px, 3cqw); margin-bottom: 0.35cqw; transition: transform var(--t-micro) var(--ease); }
  .fs-arrow svg { width: 100%; height: auto; overflow: visible; }
  .fs-arrow path { fill: none; stroke: var(--cobalt); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .fs-title a:hover .fs-arrow, .fs-title a:focus-visible .fs-arrow { transform: translateX(4px); }
  .fs-title a:hover .fs-title-text { color: #000; }

  .fs-divider { align-self: stretch; width: 1px; background: var(--line); margin-block: 0.6cqw; }

  /* slider */
  .fs-range { position: relative; height: 34px; margin-top: 2.2cqw; }
  .fs-value {
    position: absolute; bottom: calc(100% + 2px);
    left: calc(var(--t) * (100% - 22px) + 11px);
    transform: translateX(-50%);
    font-weight: 600; font-size: max(12px, 1.05cqw); font-variant-numeric: tabular-nums;
  }
  .fs-ticks { position: absolute; left: 11px; right: 11px; top: 50%; height: 10px; margin-top: -5px; pointer-events: none; }
  .fs-ticks i { position: absolute; top: 0; width: 1px; height: 10px; background: rgba(23, 23, 23, 0.28); }
  .fs-ticks i:first-child { opacity: 0.6; }
  .fs-range input {
    -webkit-appearance: none; appearance: none;
    position: relative; width: 100%; height: 34px; margin: 0; background: transparent; cursor: pointer;
  }
  .fs-range input::-webkit-slider-runnable-track {
    height: 3px; border-radius: 3px;
    background:
      linear-gradient(to right, transparent 0, var(--cobalt) 8%, var(--cobalt) calc(var(--t) * 100%), transparent calc(var(--t) * 100%)),
      repeating-linear-gradient(to right, rgba(23,23,23,0.25) 0 3px, transparent 3px 6px) 0 0 / 9% 100% no-repeat,
      linear-gradient(rgba(23,23,23,0.18), rgba(23,23,23,0.18)) 9% 0 / 91% 100% no-repeat;
  }
  .fs-range input::-moz-range-track { height: 3px; background: rgba(23,23,23,0.18); }
  .fs-range input::-moz-range-progress { height: 3px; background: var(--cobalt); }
  .fs-range input::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 22px; height: 22px; margin-top: -9.5px; border-radius: 50%;
    background: var(--cobalt);
    box-shadow: 0 0 0 5px rgba(36, 82, 214, 0.14), -10px 0 12px rgba(36, 82, 214, 0.35);
    transition: transform 160ms var(--ease);
  }
  .fs-range input::-moz-range-thumb { width: 20px; height: 20px; border: 0; border-radius: 50%; background: var(--cobalt); box-shadow: 0 0 0 5px rgba(36, 82, 214, 0.14); }
  .fs-range input:hover::-webkit-slider-thumb { transform: scale(1.1); }
  .fs-range input:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 4px; border-radius: 6px; }
  .fs-ends { display: flex; justify-content: space-between; margin-top: 0.2cqw; font-size: max(12px, 1.1cqw); color: var(--cobalt); opacity: 0.85; }
  .fs-ends span:first-child { transform: rotate(-3deg); }
  .fs-ends span:last-child { transform: rotate(-3deg); }

  /* taped photo */
  .fs-photo { position: relative; margin: 0; padding: 0.45cqw; background: #fff; transform: rotate(-3deg); box-shadow: 0 10px 22px -14px rgba(23, 23, 23, 0.5); justify-self: center; width: 100%; max-width: 170px; }
  .fs-night { display: block; width: 100%; height: auto; }
  .fs-photo-tape { position: absolute; z-index: 1; right: -1.4cqw; top: -0.9cqw; width: 45%; height: 1.5cqw; min-height: 12px; background: rgba(242, 200, 75, 0.85); transform: rotate(2deg); }

  .fs-note { margin: 0; position: relative; font-size: max(11px, 1.05cqw); line-height: 1.15; color: var(--cobalt); transform: rotate(-12deg); padding-bottom: 2.4cqw; }
  .fs-note svg { position: absolute; left: -0.6cqw; bottom: -0.6cqw; width: 2.6cqw; min-width: 24px; overflow: visible; }
  .fs-note path { fill: none; stroke: var(--cobalt); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }

  /* scroll cue */
  .fs-scroll { display: flex; flex-direction: column; align-items: center; gap: 0; width: fit-content; min-height: 44px; margin: -6px auto 0; position: relative; z-index: 1; }
  .fs-scroll svg { width: 22px; height: 14px; }
  .fs-scroll path { fill: none; stroke: var(--grey); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: stroke var(--t-micro); }
  .fs-scroll .hand { font-size: 0.95rem; color: var(--grey); transition: color var(--t-micro); }
  .fs-scroll:hover path { stroke: var(--cobalt); }
  .fs-scroll:hover .hand { color: var(--cobalt); }
  .fs-scroll:hover svg { transform: translateY(2px); transition: transform var(--t-micro) var(--ease); }

  @media (max-width: 900px) { .fstrip { margin-top: 56px; } }

  /* title + detail stack in the first column; everything else spans both rows */
  .fs-title { grid-row: 1; align-self: end; }
  .fs-detail { grid-column: 1; grid-row: 2; align-self: start; margin-top: 10px; }
  .fs-divider, .fs-slider, .fs-photo, .fs-note { grid-row: 1 / span 2; }
  .fs-copy { font-family: var(--font-serif-text); font-size: max(13px, 0.98cqw); line-height: 1.5; color: #3b3833; max-width: 46ch; }
  .fs-ev { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .fs-ev li { padding: 3px 10px; font-size: 0.78rem; font-weight: 500; color: var(--cobalt); border: 1px solid var(--cobalt-line); border-radius: 999px; }
  .fs-illus { display: inline-block; margin-bottom: 4px; font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--grey); border: 1px dashed var(--line-strong); border-radius: 3px; padding: 2px 6px 1px; }

  /* ---------- smaller screens: stack ---------- */
  @container (max-width: 820px) {
    .fs-card { grid-template-columns: 1fr minmax(0, 150px); row-gap: 28px; padding: 40px 22px 26px; }
    .fs-title, .fs-detail, .fs-slider { grid-column: 1 / -1; }
    .fs-title { grid-row: 1; } .fs-detail { grid-row: 2; margin-top: 0; } .fs-slider { grid-row: 3; }
    .fs-divider { display: none; }
    .fs-tape { top: -12px; left: 12px; font-size: 11px; padding: 5px 14px 4px; }
    .fs-range { margin-top: 24px; }
    .fs-photo { grid-column: 2; grid-row: 4; padding: 5px; max-width: 150px; }
    .fs-photo-tape { right: -10px; top: -8px; height: 14px; }
    .fs-note { grid-column: 1; grid-row: 4; justify-self: end; font-size: 1rem; padding-bottom: 0; transform: rotate(-8deg); }
    .fs-note br { display: none; }
    .fs-note svg { display: none; }
    .fs-ends { font-size: 0.95rem; }
  }
</style>
