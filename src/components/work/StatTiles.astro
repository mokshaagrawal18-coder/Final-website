---
/** Key-outcome tiles. Numbers count up once when they scroll into view (see work page script). */
import { icons, type Stat } from '../../data/work';
interface Props { stats: Stat[]; variant?: 'circles' | 'boxes' }
const { stats, variant = 'boxes' } = Astro.props;
---
<ul class:list={['tiles', `tiles--${variant}`]} role="list" style={`--n:${stats.length}`}>
  {stats.map((s) => (
    <li class="tile">
      <span class="tile-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icons[s.icon as keyof typeof icons]} /></svg></span>
      <span class="tile-value" data-count>{s.value}</span>
      <span class="tile-label">{s.label}</span>
    </li>
  ))}
</ul>
<style>
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  .tile { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; padding: 14px 8px; }
  .tile-icon svg { width: 24px; height: 24px; fill: none; stroke: var(--cobalt); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .tile-value { font-family: var(--font-serif-text); font-weight: 600; font-size: 1.3rem; line-height: 1.15; color: var(--ink); font-variant-numeric: tabular-nums; }
  .tile-label { font-family: var(--font-serif-text); font-size: 0.9rem; line-height: 1.3; color: var(--grey); max-width: 13ch; }

  .tiles--circles .tile-icon { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; background: #E3EAFB; margin-bottom: 6px; transition: transform var(--t-micro) var(--ease); }
  .tiles--circles .tile-icon svg { width: 26px; height: 26px; }
  .tiles--circles .tile:hover .tile-icon { transform: translateY(-3px); }

  .tiles--boxes { grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); background: #FBF8F1; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  /* hairlines drawn by each tile, so a short last row leaves no grey gap */
  .tiles--boxes .tile { box-shadow: 1px 0 0 var(--line), 0 1px 0 var(--line); }
  .tiles--boxes .tile { align-items: flex-start; text-align: left; padding: 16px 16px 14px; transition: background-color var(--t-micro) var(--ease); }
  .tiles--boxes .tile:hover { background: #F4F2EE; }
  .tiles--boxes .tile-icon { margin-bottom: 4px; }
  .tiles--boxes .tile-value { font-size: 1.2rem; }

  @media (max-width: 640px) {
    .tiles--circles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
