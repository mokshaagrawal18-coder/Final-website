---
/**
 * Work page: education (with the quant subjects pulled forward) and a light leadership strip.
 * Kept short on purpose: the jobs above are the main story, this is context.
 */
const schools = [
  {
    when: '2022 – 25',
    where: 'CHRIST University, Bengaluru',
    what: 'BBA Finance',
    big: '3.56', bigUnit: '/4.0 GPA',
    line: 'Statistics and econometrics moved me from “what happened” to “why it happened”. My undergraduate research used regression to study healthcare spending.',
    subjects: ['Statistics', 'Econometrics', 'Business Analytics', 'Business Mathematics', 'Financial Modelling'],
    link: { href: '/projects/healthcare-expenditure/', label: 'see the research' },
  },
  {
    when: '2020 – 22',
    where: 'Class XI–XII, CBSE',
    what: 'Mathematics and Computer Science',
    big: '96.2%', bigUnit: 'overall',
    line: 'Two years of Python and SQL before college, alongside maths with calculus, matrices and probability.',
    subjects: ['Python', 'SQL', 'Calculus', 'Matrices', 'Probability'],
    scores: ['99/100 Computer Science', '95/100 Mathematics'],
  },
];

const lead = [
  { name: 'Team Dhadak', role: 'Dance Coordinator · 2022–25', line: 'Led a 12-member inter-college dance team and rebuilt how auditions and selection worked.', stat: '+60% participation' },
  { name: 'Team Snappers', role: 'Associate Head · 2022–25', line: 'Ran photography for School of Business and Management events.', stat: '30+ shoots' },
  { name: 'Bharatanatyam', role: 'Since 2009', line: 'Indian classical dance. Vidwat degree and a state-board proficiency certification.', stat: '15+ years' },
  { name: 'Youth for Parivarthan', role: 'Volunteer · 2023', line: 'Public-space restoration, wall art and outreach across 15 Bengaluru neighbourhoods.', stat: '250+ hours' },
];
---
<section class="section container edu" id="education" aria-labelledby="edu-title">
  <div class="edu-head">
    <p class="label">Education</p>
    <h2 class="edu-title" id="edu-title">Where the numbers started</h2>
    <p class="hand edu-note">the maths came before the jobs.</p>
  </div>

  <div class="edu-grid">
    {schools.map((s, i) => (
      <article class="edu-card reveal" style={`--delay:${i * 90}ms`}>
        <p class="edu-when">{s.when}</p>
        <h3 class="edu-where">{s.where}</h3>
        <p class="edu-what">{s.what}</p>
        <p class="edu-big"><span>{s.big}</span> {s.bigUnit}</p>
        <p class="edu-line">{s.line}</p>
        <p class="edu-lab">quant & code</p>
        <ul class="edu-subj" role="list">{s.subjects.map((x) => <li>{x}</li>)}</ul>
        {s.scores && <p class="edu-scores">{s.scores.join(' · ')}</p>}
        {s.link && <a href={s.link.href} class="edu-link">{s.link.label} <span aria-hidden="true">→</span></a>}
      </article>
    ))}
  </div>
</section>

<section class="container lead" aria-labelledby="lead-title">
  <div class="lead-wrap">
    <figure class="lead-photo">
      <img src="/images/dance.webp" alt="Mid-spin on stage, in a pink dupatta and embroidered skirt." width="900" height="587" loading="lazy" decoding="async" />
      <figcaption class="hand">on stage</figcaption>
    </figure>
    <div>
      <p class="label" id="lead-title">Outside work</p>
      <ul class="lead-list" role="list">
        {lead.map((l) => (
          <li>
            <p class="lead-name">{l.name} <span>{l.role}</span></p>
            <p class="lead-line">{l.line} <b>{l.stat}</b></p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .edu { padding-top: clamp(110px, 10vw, 160px); }
  .edu-head { margin-bottom: 32px; }
  .edu-head .label { margin-bottom: 12px; }
  .edu-title { font-family: var(--font-serif-display); font-weight: 400; font-size: clamp(2rem, 1.5rem + 1.6vw, 2.9rem); letter-spacing: -0.015em; }
  .edu-note { margin-top: 10px; display: inline-block; font-size: 1.15rem; color: var(--cobalt); transform: rotate(-1.5deg); transform-origin: left; }

  .edu-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .edu-card { display: flex; flex-direction: column; padding: var(--pad-panel); background: var(--paper); border-radius: 10px; box-shadow: var(--shadow-paper); }
  .edu-when { font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--grey); font-weight: 500; }
  .edu-where { margin-top: 8px; font-family: var(--font-serif-display); font-weight: 400; font-size: 1.45rem; line-height: 1.15; }
  .edu-what { margin-top: 2px; font-size: 0.92rem; color: var(--grey); }
  .edu-big { margin-top: 14px; font-size: 0.85rem; color: var(--grey); }
  .edu-big span { font-family: var(--font-head); font-size: 2rem; line-height: 1; color: var(--cobalt); font-variant-numeric: tabular-nums; }
  .edu-line { margin-top: 12px; font-size: 0.95rem; line-height: 1.55; color: #3b3833; max-width: 52ch; }
  .edu-lab { margin-top: 16px; font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--grey); }
  .edu-subj { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .edu-subj li { padding: 3px 10px; font-size: 0.78rem; font-weight: 600; color: var(--cobalt); background: rgba(36, 82, 214, 0.1); border-radius: 999px; }
  .edu-scores { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 0.85rem; font-weight: 600; color: var(--ink); }
  .edu-link { margin-top: auto; padding-top: 16px; width: fit-content; font-size: 0.9rem; font-weight: 500; color: var(--cobalt); }
  .edu-link span { display: inline-block; transition: transform var(--t-micro) var(--ease); }
  .edu-link:hover span { transform: translateX(3px); }

  .lead { padding-top: clamp(56px, 6vw, 88px); }
  .lead-wrap { display: grid; grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 56px); align-items: center; padding-top: 28px; border-top: 1px solid var(--line-strong); }
  .lead-photo { position: relative; margin: 0; padding: 8px 8px 30px; background: #fff; transform: rotate(-2deg); box-shadow: 0 14px 26px -18px rgba(60, 45, 20, 0.55), 0 1px 1px rgba(60, 45, 20, 0.12); }
  .lead-photo::before { content: ''; position: absolute; top: -10px; left: 50%; width: 76px; height: 20px; margin-left: -38px; background: rgba(226, 214, 186, 0.85); transform: rotate(-3deg); }
  .lead-photo img { display: block; width: 100%; height: auto; }
  .lead-photo figcaption { position: absolute; left: 10px; bottom: 5px; font-size: 0.95rem; color: var(--cobalt); }
  .lead .label { margin-bottom: 8px; }
  .lead-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 28px; }
  .lead-list li { padding-top: 12px; border-top: 1px solid var(--line); }
  .lead-name { font-weight: 600; font-size: 0.98rem; }
  .lead-name span { display: block; font-weight: 400; font-size: 0.8rem; color: var(--grey); }
  .lead-line { margin-top: 6px; font-size: 0.88rem; line-height: 1.5; color: #4a4741; }
  .lead-line b { display: block; margin-top: 4px; font-weight: 600; color: var(--cobalt); }

  @media (max-width: 860px) {
    .edu-grid, .lead-wrap { grid-template-columns: 1fr; }
    .lead-photo { max-width: 360px; }
  }
  @media (max-width: 560px) {
    .lead-list { grid-template-columns: 1fr; }
  }
</style>
