---
/**
 * Company marks. Groww and BRND.ME use the supplied logo files; D. E. Shaw is set as type
 * with its teal rule until a full logo file is available.
 */
interface Props { id: string; name: string; size?: 'sm' | 'lg'; as?: string; titleId?: string }
const { id, name, size = 'sm', as: Tag = 'span', titleId } = Astro.props;
---
<Tag class:list={['cm', `cm--${size}`, `cm-${id}`]} id={titleId}>
  {id === 'de-shaw' && (
    <span class="cm-des">
      <svg class="cm-des-rule" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M0 12 H 128 L 152 2 H 200" /></svg>
      <span class="cm-des-name">D. E. Shaw &amp; Co</span>
    </span>
  )}
  {id === 'groww' && (
    <span class="cm-row">
      <img src="/logos/groww.png" alt="" width="188" height="188" class="cm-groww-logo" />
      <span class="cm-groww-name">Groww</span>
    </span>
  )}
  {id === 'mensa' && (
    <span class="cm-row">
      <img src="/logos/brndme.png" alt="" width="101" height="71" class="cm-mensa-logo" />
      <span class="cm-mensa-name">Mensa<br />Brands</span>
    </span>
  )}
  <span class="visually-hidden">{name}</span>
</Tag>
<style>
  .cm { display: block; width: fit-content; line-height: 1; font-weight: 400; }
  .cm-des { display: inline-flex; flex-direction: column; }
  .cm-des-rule { width: 100%; height: 0.32em; margin-bottom: 0.06em; overflow: visible; }
  .cm-des-rule path { fill: none; stroke: #2A967C; stroke-width: 1.6; vector-effect: non-scaling-stroke; }
  .cm-des-name { font-family: var(--font-serif-display); color: #12306A; letter-spacing: -0.02em; white-space: nowrap; }
  .cm-row { display: inline-flex; align-items: center; gap: 0.32em; }
  .cm-groww-logo { width: 1.25em; height: 1.25em; }
  .cm-groww-name { font-family: var(--font-body); font-weight: 600; letter-spacing: -0.035em; color: #111; }
  .cm-mensa-logo { width: auto; height: 1.5em; }
  .cm-mensa-name { font-family: var(--font-body); font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; font-size: 0.62em; line-height: 1.02; color: #111; }
  .cm--sm { font-size: 1.85rem; }
  .cm--lg { font-size: clamp(2.1rem, 1.6rem + 1.4vw, 2.8rem); }
  .cm-des-name > :global(*) { display: none; }
  /* the visible text already carries the name; keep the hidden copy for logo-only marks */
  .cm-de-shaw > .visually-hidden { display: none; }
</style>
