---
// sample positions only (x: ratings, y: price) — not real products
const rand = (() => { let s = 11; return () => ((s = (s * 9301 + 49297) % 233280) / 233280); })();
const dots = Array.from({ length: 30 }, () => ({ x: 40 + rand() * 175, y: 18 + rand() * 120 }));
---
<figure class="ml">
  <p class="panel-title">The shelf around the product <span class="panel-sub">(sample view)</span></p>
  <div class="ml-row">
    <svg class="ml-chart" viewBox="0 0 300 175" role="img" aria-label="Sample scatter of competitor products by price and rating, with the portfolio's focus area highlighted at higher ratings.">
      <path d="M30 150 V 10 M26 15 L30 8 L34 15" class="ml-axis" />
      <path d="M30 150 H 250 M243 146 L250 150 L243 154" class="ml-axis" />
      <line x1="130" y1="14" x2="130" y2="150" class="ml-mid" />
      <text x="24" y="16" class="ml-t ml-t--end">Higher price</text>
      <text x="24" y="146" class="ml-t ml-t--end">Lower price</text>
      <text x="70" y="166" class="ml-t">Lower ratings</text>
      <text x="200" y="166" class="ml-t">Higher ratings</text>
      <g class="ml-dots">
        {dots.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="3" />)}
      </g>
      <ellipse cx="236" cy="45" rx="44" ry="28" class="ml-zone" />
      <circle cx="222" cy="44" r="9" class="ml-us-halo" />
      <circle cx="222" cy="44" r="3.4" class="ml-us" />
      <text x="234" y="41" class="ml-us-t">our</text>
      <text x="234" y="52" class="ml-us-t">portfolio</text>
    </svg>
  </div>
</figure>

<style>
  .ml { margin: 0; }
  .ml-row { margin-top: 10px; max-width: 420px; }
  .ml-chart { width: 100%; height: auto; overflow: visible; }
  .ml-axis { fill: none; stroke: var(--ink); stroke-width: 1.1; stroke-linecap: round; stroke-linejoin: round; }
  .ml-mid { stroke: var(--line-strong); stroke-dasharray: 2 3; }
  .ml-t { font-family: var(--font-serif-text); font-size: 8px; fill: var(--grey); text-anchor: middle; }
  .ml-t--end { text-anchor: end; }
  .ml-dots circle { fill: #A8A49C; transition: opacity 400ms var(--ease), fill 300ms; }
  .ml-zone { fill: rgba(242, 200, 75, 0.12); stroke: var(--yellow); stroke-width: 1; stroke-dasharray: 3 3; transition: fill 300ms, stroke-width 300ms; }
  .ml-us-halo { fill: rgba(242, 200, 75, 0.7); }
  .ml-us { fill: var(--cobalt); }
  .ml-us-t { font-family: var(--font-serif-text); font-size: 8.5px; fill: var(--cobalt); }
</style>
