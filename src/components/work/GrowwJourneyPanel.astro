---
import StatTiles from './StatTiles.astro';
import type { Stat } from '../../data/work';
interface Props { stats: Stat[] }
const { stats } = Astro.props;
const steps = [
  { label: 'Sign up', sub: 'Account creation', friction: false },
  { label: 'KYC', sub: 'Verification delays', friction: true },
  { label: 'Activation', sub: 'Confusion about next steps', friction: true },
  { label: 'Invest', sub: 'First investment', friction: false },
];
---
<div class="gj" data-journey data-reveal>
  <h3 class="panel-title">Customer journey <span class="panel-sub">(early users)</span></h3>
  <div class="gj-row">
    <ol class="gj-steps" role="list">
      <span class="gj-line" aria-hidden="true"><span class="gj-fill"></span></span>
      {steps.map((s, i) => (
        <li style={`--i:${i}`}>
          <button type="button" class:list={['gj-step', { 'is-friction': s.friction }]} aria-pressed="false">
            <span class="gj-label">{s.label}</span>
            <span class="gj-dot" aria-hidden="true"></span>
            <span class="gj-sub hand">{s.sub}</span>
            {s.friction && <span class="visually-hidden">(friction point)</span>}
          </button>
        </li>
      ))}
    </ol>
    <span class="gj-arrow" aria-hidden="true">→</span>
    <p class="hand gj-note" aria-hidden="true">Smoother journeys. More confident investors.</p>
  </div>
  <p class="gj-hint hand" aria-hidden="true"><span class="gj-key"></span> where people got stuck · tap a step</p>

  <p class="ko-label">Key outcomes</p>
  <StatTiles stats={stats} />
</div>

<style>
  .gj-row { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 0.32fr); align-items: start; gap: 10px; margin-top: 16px; }
  .gj-steps { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .gj-line { position: absolute; left: 12.5%; right: 12.5%; top: 37px; height: 2px; background: rgba(36, 82, 214, 0.2); }
  .gj-fill { position: absolute; inset: 0; background: var(--cobalt); transform-origin: left; }
  :global(.js) .gj:not(.is-in) .gj-fill { transform: scaleX(0); }
  .gj-fill { transition: transform 1000ms var(--ease) 200ms; }
  .gj-step {
    position: relative; width: 100%;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    padding: 0 4px 6px; border: 0; background: none; text-align: center; border-radius: 6px;
  }
  .gj-label { font-family: var(--font-serif-text); font-size: 0.95rem; color: var(--ink); }
  .gj-dot { position: relative; z-index: 1; width: 14px; height: 14px; border-radius: 50%; background: var(--cobalt); box-shadow: 0 0 0 3px var(--paper); transition: transform var(--t-micro) var(--ease), box-shadow var(--t-micro); }
  .is-friction .gj-dot { background: var(--yellow); }
  .gj-sub { font-size: 0.9rem; line-height: 1.15; color: var(--grey); transition: color var(--t-micro); }
  .gj-step:hover .gj-dot, .gj-step[aria-pressed='true'] .gj-dot { transform: scale(1.35); box-shadow: 0 0 0 3px var(--paper), 0 0 0 7px rgba(36, 82, 214, 0.15); }
  .gj-step:hover .gj-sub, .gj-step[aria-pressed='true'] .gj-sub { color: var(--ink); }
  .is-friction[aria-pressed='true'] .gj-sub { background: linear-gradient(transparent 55%, var(--yellow-soft) 55%); }
  .gj-arrow { color: var(--cobalt); font-size: 1.4rem; line-height: 1; margin-top: 26px; }
  .gj-note { font-size: 1rem; line-height: 1.2; transform: rotate(-12deg); margin-top: -6px; }
  .gj-hint { display: flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 0.85rem; color: var(--grey); }
  .gj-key { width: 10px; height: 10px; border-radius: 50%; background: var(--yellow); }

  @media (max-width: 640px) {
    .gj-row { grid-template-columns: 1fr; }
    .gj-arrow { display: none; }
    .gj-note { transform: rotate(-3deg); }
  }
</style>
