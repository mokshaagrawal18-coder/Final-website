---
/** Groww: the activation journey, with the two steps where people got stuck marked. Static. */
const steps = [
  { label: 'Sign up', friction: false },
  { label: 'KYC', friction: true },
  { label: 'Verification', friction: true },
  { label: 'Activation', friction: false },
];
---
<figure class="gj" aria-label="Customer journey: sign up, KYC, verification, activation. Most friction sat at KYC and verification.">
  <p class="panel-title">Where people got stuck</p>
  <ol class="gj-steps" role="list" aria-hidden="true">
    {steps.map((s) => (
      <li class:list={['gj-step', { 'is-friction': s.friction }]}>
        <span class="gj-dot"></span>
        <span class="gj-label">{s.label}</span>
      </li>
    ))}
  </ol>
  <p class="gj-key"><span></span> documents and verification checks</p>
</figure>
<style>
  .gj { margin: 0; }
  .gj-steps { position: relative; list-style: none; margin: 22px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 8px; }
  .gj-steps::before { content: ''; position: absolute; left: 12.5%; right: 12.5%; top: 6px; height: 2px; background: var(--cobalt); opacity: 0.35; }
  .gj-step { position: relative; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .gj-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--cobalt); box-shadow: 0 0 0 3px var(--cream); }
  .is-friction .gj-dot { background: var(--yellow); box-shadow: 0 0 0 3px var(--cream), 0 0 0 5px rgba(242, 200, 75, 0.45); }
  .gj-label { font-family: var(--font-serif-text); font-size: 0.8rem; color: var(--ink); }
  .gj-key { display: flex; align-items: center; gap: 8px; margin-top: 18px; font-size: 0.8rem; color: var(--grey); }
  .gj-key span { width: 10px; height: 10px; border-radius: 50%; background: var(--yellow); }
</style>
