---
/**
 * The blue route across Home: start here → Work → Projects → About → Notes → pick a route.
 * Desktop: one coordinate system (556 × 112, the reference layout's own units) shared by the
 * SVG curve and the HTML stops, so everything scales together.
 * Phones: the same stops as a vertical path down the left edge.
 */
const W = 556;
const H = 112;
const pct = (x: number, y: number) => `--x:${((x / W) * 100).toFixed(2)}%;--y:${((y / H) * 100).toFixed(2)}%`;
// container-query units: 1 reference unit = (100 / W) cqw, the same on both axes
const cq = (v: number) => `${((v / W) * 100).toFixed(3)}cqw`;
const at = (s: { node: number[]; tag: number[]; subAt: number[] }) =>
  `--tx:${cq(s.tag[0])};--ty:${cq(s.tag[1])};--nx:${cq(s.node[0] - s.tag[0])};--ny:${cq(s.node[1] - s.tag[1])};--sx:${cq(s.subAt[0] - s.tag[0])};--sy:${cq(s.subAt[1] - s.tag[1])}`;

const stops = [
  {
    label: 'Work', sub: ['what I do', 'and care about'], href: '/work/', tone: 'blue',
    node: [122, 37], tag: [121, 53], subAt: [107, 74], iconAt: 'left',
    icon: 'M5 6h14v9H5zM3 18h18l-1.5-3h-15z',
  },
  {
    label: 'Projects', sub: ['ideas into', 'real things'], href: '/projects/', tone: 'yellow',
    node: [229, 50.5], tag: [230, 66], subAt: [214, 87], iconAt: 'right',
    icon: 'M5 20v-5M10 20v-8M15 20v-11M20 20V4', bars: true,
  },
  {
    label: 'About', sub: ['the bigger', 'picture'], href: '/about/', tone: 'blue',
    node: [321, 9], tag: [324, 26], subAt: [308, 38], iconAt: 'right',
    icon: 'M12 3.5a3.5 3.5 0 1 0 0.01 0M5 21c0-4.5 3-7.5 7-7.5s7 3 7 7.5z',
  },
  {
    label: 'Notes', sub: ['thoughts', 'in progress'], href: '/notes/', tone: 'yellow',
    node: [454, 45], tag: [457, 62], subAt: [444, 83], iconAt: 'right',
    icon: 'M6 4h12v17H6zM9 2.5v3M15 2.5v3M9 10h6M9 14h6M9 18h4',
  },
];

// points the curve passes through, read off the reference
const pts: [number, number][] = [
  [34.7, 48], [69, 31.6], [102.7, 20], [122, 37], [176, 46], [229, 50.5],
  [264, 26], [300, 3], [321, 9], [375, 29], [416, 50], [454, 45], [500, 43], [541, 19],
];
// Catmull-Rom → cubic Bézier
const path = pts.reduce((d, p, i, a) => {
  if (i === 0) return `M${p[0]} ${p[1]}`;
  const p0 = a[i - 2] ?? a[i - 1], p1 = a[i - 1], p3 = a[i + 1] ?? p;
  const c1 = [p1[0] + (p[0] - p0[0]) / 6, p1[1] + (p[1] - p0[1]) / 6];
  const c2 = [p[0] - (p3[0] - p1[0]) / 6, p[1] - (p3[1] - p1[1]) / 6];
  return `${d} C${c1[0].toFixed(2)} ${c1[1].toFixed(2)} ${c2[0].toFixed(2)} ${c2[1].toFixed(2)} ${p[0]} ${p[1]}`;
}, '');
---
<nav class="route" aria-label="Pick a route through the site" style={`--ar:${W}/${H}`}>
  <svg class="route-line" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
    <path class="rl-path" d={path} />
    <!-- paper-plane arrowhead -->
    <path class="rl-plane" d="M537 21.5 L549.5 11 L545 25.5 Z M537 21.5 L543 19.5" />
    <!-- start: yellow dot with a blue centre -->
    <circle cx="34.7" cy="48" r="5.2" class="rl-start" />
    <circle cx="34.7" cy="48" r="2.1" class="rl-start-c" />
    <!-- start here arrow -->
    <path class="rl-hint" d="M28 21 C 23 28, 24 34, 29 39 M25.5 36 L29.5 39.5 L30.5 34.5" />
  </svg>

  <p class="hand route-hint route-hint--start" aria-hidden="true" style={pct(22, 2)}>start<br />&nbsp;&nbsp;here</p>

  <ol class="route-stops" role="list">
    {stops.map((s, i) => (
      <li class="stop" style={`--i:${i}`}>
        <a href={s.href} class="stop-link" style={at(s)}>
          <span class="stop-node" aria-hidden="true"></span>
          <span class:list={['stop-tag', `is-${s.tone}`]}>{s.label}</span>
          <span class:list={['stop-sub hand', `icon-${s.iconAt}`]}>
            <span class="stop-sub-text">{s.sub[0]}<br />&nbsp;{s.sub[1]}</span>
            <svg class:list={['stop-icon', { 'is-bars': s.bars }]} viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} /></svg>
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .route { position: relative; width: 100%; aspect-ratio: var(--ar); container-type: inline-size; }
  .route-line { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .rl-path { fill: none; stroke: var(--cobalt); stroke-width: 1.15; stroke-linecap: round; }
  .rl-plane { fill: var(--cream); stroke: var(--cobalt); stroke-width: 1; stroke-linejoin: round; stroke-linecap: round; }
  .rl-start { fill: var(--yellow); }
  .rl-start-c { fill: var(--cobalt); }
  .rl-hint { fill: none; stroke: var(--cobalt); stroke-width: 0.7; stroke-linecap: round; stroke-linejoin: round; }

  /* the line draws left to right, once */
  :global(.js) .route-line { clip-path: inset(-30% 100% -30% -5%); animation: route-draw 1100ms var(--ease) 250ms forwards; }
  @keyframes route-draw { to { clip-path: inset(-30% -5% -30% -5%); } }

  .route-hint { position: absolute; left: var(--x); top: var(--y); }
  /* each link is a zero-size anchor at its tag; node and caption hang off it */
  .stop-link { position: absolute; left: var(--tx); top: var(--ty); width: 0; height: 0; }
  .stop-tag { position: absolute; left: 0; top: 0; }
  .stop-node { position: absolute; left: var(--nx); top: var(--ny); }
  .stop-sub { position: absolute; left: var(--sx); top: var(--sy); }
  .stop-link:focus-visible { outline: none; }
  .route-hint--start { margin: 0; font-size: max(12px, 1.2cqw); line-height: 1; transform: rotate(-22deg); transform-origin: left top; }

  .route-stops { list-style: none; margin: 0; padding: 0; }
  .stop-node {
    width: max(10px, 1.3cqw); aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff; border: 2px solid var(--cobalt);
    transition: background-color var(--t-micro) var(--ease), box-shadow var(--t-micro) var(--ease);
  }
  .stop-tag {
    transform: translate(-50%, -50%) rotate(-1.5deg);
    padding: 0.12em 0.5em 0.1em;
    font-family: var(--font-serif-display); font-weight: 400;
    font-size: max(15px, 1.72cqw); line-height: 1.15; letter-spacing: -0.01em;
    color: var(--ink);
    background: var(--tag-bg);
    border-radius: 3px 6px 4px 7px / 6px 3px 7px 4px;
    box-shadow: 1px 0 0 var(--tag-bg), -1px 1px 0 var(--tag-bg);
    transition: transform var(--t-micro) var(--ease), box-shadow var(--t-micro) var(--ease);
    white-space: nowrap;
  }
  .stop-tag.is-blue { --tag-bg: #CFDCFA; }
  .stop-tag.is-yellow { --tag-bg: #F8E3A0; }
  .stop-sub {
    display: flex; align-items: center; gap: 0.5em;
    font-size: max(11px, 1.2cqw); line-height: 1.15;
    color: var(--cobalt); opacity: 0.82;
    transform: rotate(-4deg); transform-origin: left top;
    white-space: nowrap;
    transition: opacity var(--t-micro) var(--ease);
  }
  .stop-sub.icon-left { flex-direction: row-reverse; }
  .stop-sub.icon-left .stop-icon { align-self: flex-end; margin-bottom: -0.9em; }
  .stop-icon { flex: none; width: 1.7em; height: 1.7em; fill: none; stroke: var(--cobalt); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .stop-icon.is-bars { stroke-width: 2.6; stroke-linecap: butt; }

  /* hover / focus: the stop becomes the active marker */
  .stop-link:hover .stop-tag, .stop-link:focus-visible .stop-tag { transform: translate(-50%, calc(-50% - 4px)) rotate(-1.5deg); box-shadow: 0 8px 14px -10px rgba(23, 23, 23, 0.5); }
  .stop-link:hover .stop-sub, .stop-link:focus-visible .stop-sub { opacity: 1; }
  .stop-link:hover .stop-node, .stop-link:focus-visible .stop-node { background: var(--cobalt); box-shadow: 0 0 0 5px rgba(36, 82, 214, 0.15); }
  .stop-link:focus-visible .stop-tag { outline: 2px solid var(--cobalt); outline-offset: 3px; }

  :global(.js) .stop { opacity: 0; animation: stop-in 420ms var(--ease) forwards; animation-delay: calc(500ms + var(--i) * 170ms); }
  @keyframes stop-in { from { opacity: 0; } to { opacity: 1; } }

  /* ---------- phones: a vertical path ---------- */
  @media (max-width: 760px) {
    .route { aspect-ratio: auto; padding: 4px 0 0 30px; }
    .route-line, .route-hint { display: none; }
    .route::before { content: ''; position: absolute; left: 9px; top: 20px; bottom: 30px; width: 2px; background: var(--cobalt); border-radius: 2px; }
    .route-stops { display: grid; gap: 20px; }
    .stop { position: relative; }
    .stop-link { position: relative; left: auto; top: auto; width: auto; height: auto; display: flex; align-items: center; gap: 14px; min-height: 44px; }
    .stop-node, .stop-tag, .stop-sub { position: static; transform: none; }
    .stop-node { position: absolute; left: -28px; top: 50%; width: 14px; transform: translateY(-50%); }
    .stop-tag { font-size: 1.25rem; transform: rotate(-1.5deg); }
    .stop-sub { font-size: 0.95rem; transform: none; }
    .stop-sub-text br { display: none; }
    .stop-sub.icon-left { flex-direction: row; }
    .stop-sub.icon-left .stop-icon { margin: 0; align-self: center; }
    .stop-link:hover .stop-tag, .stop-link:focus-visible .stop-tag { transform: translateY(-3px) rotate(-1.5deg); }
    .stop-link:hover .stop-node, .stop-link:focus-visible .stop-node { transform: translateY(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .route-line { animation: none; clip-path: none; }
    :global(.js) .stop { animation: none; opacity: 1; }
  }
</style>
