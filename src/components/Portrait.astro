---
/**
 * The real portrait. Drop a photo into public/images/ (e.g. portrait.jpg).
 * Until it exists, a plain labelled frame holds the space so layouts stay honest.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props { src?: string; alt?: string; class?: string; eager?: boolean; ratio?: string }
const {
  src = '/images/portrait.jpg',
  alt = 'Portrait of Moksha Agrawal',
  class: cls = '',
  eager = false,
  ratio = '4 / 5',
} = Astro.props;
const has = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
// page-specific photo → shared portrait → placeholder
const resolved = has(src) ? src : has('/images/portrait.jpg') ? '/images/portrait.jpg' : null;
const exists = resolved !== null;
---
<figure class={`portrait ${cls}`} style={`--ratio:${ratio}`}>
  {exists ? (
    <img src={resolved} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
  ) : (
    <div class="portrait-empty" role="img" aria-label="Portrait placeholder">
      <svg viewBox="0 0 120 150" aria-hidden="true">
        <circle cx="60" cy="56" r="22" />
        <path d="M22 132 C 26 104, 44 92, 60 92 S 94 104, 98 132" />
      </svg>
      <span class="hand hand--grey">portrait goes here</span>
    </div>
  )}
</figure>
<style>
  .portrait { position: relative; aspect-ratio: var(--ratio); width: 100%; }
  .portrait img {
    width: 100%; height: 100%; object-fit: cover;
    border-radius: 4px;
    filter: saturate(0.94) contrast(0.98);
  }
  .portrait-empty {
    width: 100%; height: 100%;
    border-radius: 4px;
    background: #EDE5D5;
    display: grid; place-items: center; align-content: center; gap: 10px;
  }
  .portrait-empty svg { width: 34%; fill: none; stroke: rgba(104, 100, 93, 0.45); stroke-width: 2; stroke-linecap: round; }
</style>
