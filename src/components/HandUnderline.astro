---
/** A hand-drawn underline that draws itself once when it enters the viewport. */
interface Props { color?: string; width?: number; class?: string; delay?: number }
const { color = 'var(--cobalt)', width = 3, class: cls = '', delay = 200 } = Astro.props;
---
<span class={`hu ${cls}`}>
  <slot />
  <svg class="hu-line draw" data-reveal viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true" style={`--delay:${delay}ms`}>
    <path d="M2 8.5 C 40 4, 90 3.2, 128 5 S 184 8, 198 4.5" fill="none" stroke={color} stroke-width={width} stroke-linecap="round" style="--len:210" vector-effect="non-scaling-stroke" />
  </svg>
</span>
<style>
  .hu { position: relative; display: inline-block; white-space: nowrap; }
  .hu-line { position: absolute; left: -2%; right: -2%; bottom: -0.16em; width: 104%; height: 0.32em; overflow: visible; pointer-events: none; }
</style>
