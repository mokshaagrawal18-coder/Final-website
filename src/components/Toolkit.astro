---
import { toolkitSteps, tools } from '../data/work';
---
<section class="section toolkit" id="toolkit" aria-labelledby="toolkit-title">
  <div class="container">
    <div class="tk-head">
      <p class="label">Technical toolkit</p>
      <h2 class="tk-title" id="toolkit-title">How I usually work with data</h2>
      <p class="hand tk-note">the tool usually comes after the question.</p>
    </div>

    <ol class="tk-flow" role="list">
      {toolkitSteps.map((s, i) => (
        <li class="tk-step reveal" style={`--delay:${i * 80}ms`}>
          <span class="tk-n">{s.n}</span>
          <h3 class="tk-step-title">{s.title}</h3>
          <p class="tk-body">{s.body}</p>
          <ul class="tk-ex" role="list" aria-label="Examples">
            {s.examples.map((e) => <li>{e}</li>)}
          </ul>
        </li>
      ))}
    </ol>

    <ul class="tk-tools" role="list" aria-label="Tools">
      {tools.map((t) => (
        <li>
          {t.logo && <img src={`/logos/${t.logo}`} alt="" width="16" height="16" loading="lazy" />}
          {t.name}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tk-head { margin-bottom: 40px; }
  .tk-head .label { margin-bottom: 12px; }
  .tk-title { font-family: var(--font-serif-display); font-weight: 400; font-size: clamp(2rem, 1.5rem + 1.6vw, 2.9rem); letter-spacing: -0.015em; }
  .tk-note { margin-top: 10px; display: inline-block; font-size: 1.15rem; color: var(--cobalt); transform: rotate(-1.5deg); transform-origin: left; }

  /* one horizontal flow: a single rule with five stops, no cards */
  .tk-flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 28px; position: relative; }
  .tk-flow::before { content: ''; position: absolute; left: 0; right: 0; top: 11px; height: 1px; background: var(--line-strong); }
  .tk-step { position: relative; padding-top: 34px; }
  .tk-n {
    position: absolute; top: 0; left: 0;
    display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%;
    background: var(--cream); border: 1.5px solid var(--cobalt);
    font-family: var(--font-serif-text); font-size: 0.68rem; font-weight: 600; color: var(--cobalt);
  }
  .tk-step-title { font-family: var(--font-serif-text); font-weight: 600; font-size: 1.08rem; letter-spacing: -0.005em; }
  .tk-body { margin-top: 6px; font-size: 0.92rem; line-height: 1.5; color: var(--grey); max-width: 26ch; }
  .tk-ex { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 0.8rem; color: #3b3833; }
  .tk-ex li::before { content: '·'; color: var(--cobalt); margin-right: 5px; font-weight: 700; }

  .tk-tools {
    list-style: none; margin: 52px 0 0; padding: 18px 0 0;
    border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 0;
    font-size: 0.9rem; color: #3b3833;
  }
  .tk-tools li { display: inline-flex; align-items: center; gap: 6px; }
  .tk-tools li + li::before { content: '·'; color: var(--grey); margin: 0 12px; }
  .tk-tools img { width: 16px; height: 16px; object-fit: contain; }

  @media (max-width: 1000px) {
    .tk-flow { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 36px; }
    .tk-flow::before { display: none; }
    .tk-body { max-width: none; }
  }
  @media (max-width: 560px) {
    .tk-flow { grid-template-columns: 1fr; }
  }
</style>
